use std::sync::Arc;
use std::time::Duration;
use std::{collections::BTreeSet, fmt};

use analyticsdb_control::{ClusterNode, NodeRole, NodeStatus};
use analyticsdb_core::QueryResponse;
use analyticsdb_engine::PrototypeEngine;
use analyticsdb_protocol::{serve_flight_sql, serve_postgres_wire};
use assert_cmd::Command;
use tokio::net::TcpListener;
use uuid::Uuid;

#[derive(Copy, Clone, Debug, Eq, PartialEq, Ord, PartialOrd)]
enum SqlCapability {
    CreateDatabase,
    CreateSchema,
    CreateSchemaQualified,
    CreateTableAs,
    CreateTableQualifiedAs,
    CreateTableDefined,
    CreateTableQualifiedDefined,
    CreateView,
    CreateViewQualified,
    InsertValues,
    InsertValuesColumnList,
    Delete,
    Truncate,
    ShowDatabases,
    ShowSchemas,
    ShowSchemasFromDatabase,
    ShowNodes,
    ShowTables,
    ShowTablesFromSchema,
    ShowTablesFromDatabaseSchema,
    ShowViews,
    ShowViewsFromSchema,
    ShowViewsFromDatabaseSchema,
    ShowColumns,
    Describe,
    AlterUserPassword,
    DropTable,
    DropView,
    DropSchema,
    DropDatabase,
    Update,
    AlterTable,
    Explain,
    AlterSchema,
}

impl fmt::Display for SqlCapability {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        write!(f, "{self:?}")
    }
}

fn documented_sql_capabilities_from_readme() -> BTreeSet<SqlCapability> {
    let readme = include_str!("../../../README.md");
    let mut in_section = false;
    let mut capabilities = BTreeSet::new();

    for raw_line in readme.lines() {
        let line = raw_line.trim();
        if line == "Current metadata SQL subset:" {
            in_section = true;
            continue;
        }
        if in_section && line == "What does not exist yet:" {
            break;
        }
        if !in_section || !line.starts_with("- `") {
            continue;
        }

        let capability = if line.starts_with("- `CREATE DATABASE") {
            SqlCapability::CreateDatabase
        } else if line.starts_with("- `CREATE SCHEMA <name>`") {
            SqlCapability::CreateSchema
        } else if line.starts_with("- `CREATE SCHEMA <database>.<name>`") {
            SqlCapability::CreateSchemaQualified
        } else if line.starts_with("- `ALTER SCHEMA <name> RENAME TO") {
            SqlCapability::AlterSchema
        } else if line.starts_with("- `ALTER SCHEMA <database>.<name> RENAME TO") {
            SqlCapability::AlterSchema
        } else if line.starts_with("- `CREATE TABLE <name> AS") {
            SqlCapability::CreateTableAs
        } else if line.starts_with("- `CREATE TABLE <schema>.<name> AS") {
            SqlCapability::CreateTableQualifiedAs
        } else if line.starts_with("- `CREATE TABLE <name> (") {
            SqlCapability::CreateTableDefined
        } else if line.starts_with("- `CREATE TABLE <schema>.<name> (") {
            SqlCapability::CreateTableQualifiedDefined
        } else if line.starts_with("- `CREATE VIEW <name> AS") {
            SqlCapability::CreateView
        } else if line.starts_with("- `CREATE VIEW <schema>.<name> AS") {
            SqlCapability::CreateViewQualified
        } else if line.starts_with("- `INSERT INTO <table> VALUES") {
            SqlCapability::InsertValues
        } else if line.starts_with("- `INSERT INTO <table> (<column>") {
            SqlCapability::InsertValuesColumnList
        } else if line.starts_with("- `UPDATE <table>") {
            SqlCapability::Update
        } else if line.starts_with("- `DELETE FROM <table>") {
            SqlCapability::Delete
        } else if line.starts_with("- `TRUNCATE TABLE <table>") {
            SqlCapability::Truncate
        } else if line.starts_with("- `ALTER TABLE <table> ADD COLUMN") {
            SqlCapability::AlterTable
        } else if line.starts_with("- `ALTER TABLE <table> RENAME TO") {
            SqlCapability::AlterTable
        } else if line.starts_with("- `SHOW DATABASES`") {
            SqlCapability::ShowDatabases
        } else if line.starts_with("- `SHOW SCHEMAS FROM <database>`") {
            SqlCapability::ShowSchemasFromDatabase
        } else if line.starts_with("- `SHOW NODES`") {
            SqlCapability::ShowNodes
        } else if line.starts_with("- `SHOW SCHEMAS`") {
            SqlCapability::ShowSchemas
        } else if line.starts_with("- `SHOW TABLES FROM <database>.<schema>`") {
            SqlCapability::ShowTablesFromDatabaseSchema
        } else if line.starts_with("- `SHOW TABLES FROM <schema>`") {
            SqlCapability::ShowTablesFromSchema
        } else if line.starts_with("- `SHOW TABLES`") {
            SqlCapability::ShowTables
        } else if line.starts_with("- `SHOW VIEWS FROM <database>.<schema>`") {
            SqlCapability::ShowViewsFromDatabaseSchema
        } else if line.starts_with("- `SHOW VIEWS FROM <schema>`") {
            SqlCapability::ShowViewsFromSchema
        } else if line.starts_with("- `SHOW VIEWS`") {
            SqlCapability::ShowViews
        } else if line.starts_with("- `SHOW COLUMNS FROM <table>`") {
            SqlCapability::ShowColumns
        } else if line.starts_with("- `DESCRIBE <table>`") {
            SqlCapability::Describe
        } else if line.starts_with("- `ALTER USER <name> PASSWORD '<new>'`") {
            SqlCapability::AlterUserPassword
        } else if line.starts_with("- `EXPLAIN <query>`") {
            SqlCapability::Explain
        } else if line.starts_with("- `DROP DATABASE <name>`") {
            SqlCapability::DropDatabase
        } else if line.starts_with("- `DROP SCHEMA <name>`") {
            SqlCapability::DropSchema
        } else if line.starts_with("- `DROP TABLE <table>`") {
            SqlCapability::DropTable
        } else if line.starts_with("- `DROP VIEW <view>`") {
            SqlCapability::DropView
        } else {
            panic!("Unmapped README SQL bullet in supported subset: {line}");
        };

        capabilities.insert(capability);
    }

    capabilities
}

fn parity_matrix_sql_capabilities() -> BTreeSet<SqlCapability> {
    BTreeSet::from([
        SqlCapability::CreateDatabase,
        SqlCapability::CreateSchema,
        SqlCapability::CreateSchemaQualified,
        SqlCapability::CreateTableAs,
        SqlCapability::CreateTableQualifiedAs,
        SqlCapability::CreateTableDefined,
        SqlCapability::CreateTableQualifiedDefined,
        SqlCapability::CreateView,
        SqlCapability::CreateViewQualified,
        SqlCapability::InsertValues,
        SqlCapability::InsertValuesColumnList,
        SqlCapability::Update,
        SqlCapability::Delete,
        SqlCapability::Truncate,
        SqlCapability::AlterTable,
        SqlCapability::ShowDatabases,
        SqlCapability::ShowSchemas,
        SqlCapability::ShowSchemasFromDatabase,
        SqlCapability::ShowNodes,
        SqlCapability::ShowTables,
        SqlCapability::ShowTablesFromSchema,
        SqlCapability::ShowTablesFromDatabaseSchema,
        SqlCapability::ShowViews,
        SqlCapability::ShowViewsFromSchema,
        SqlCapability::ShowViewsFromDatabaseSchema,
        SqlCapability::ShowColumns,
        SqlCapability::Describe,
        SqlCapability::AlterUserPassword,
        SqlCapability::DropTable,
        SqlCapability::DropView,
        SqlCapability::DropSchema,
        SqlCapability::DropDatabase,
        SqlCapability::Explain,
        SqlCapability::AlterSchema,
    ])
}

fn temp_catalog_path() -> String {
    let mut path = std::env::temp_dir();
    path.push(format!("analyticsdb-cli-test-{}.json", Uuid::now_v7()));
    path.to_string_lossy().into_owned()
}

fn cleanup_catalog_artifacts(catalog_path: &str) {
    let _ = std::fs::remove_file(catalog_path);
    let mut managed_dir = std::path::PathBuf::from(catalog_path);
    let stem = managed_dir
        .file_stem()
        .and_then(|value| value.to_str())
        .expect("catalog path should have a file stem")
        .to_string();
    managed_dir.set_file_name(format!("{stem}.managed"));
    let _ = std::fs::remove_dir_all(managed_dir);
}

struct BackgroundServer {
    task: tokio::task::JoinHandle<anyhow::Result<()>>,
}

impl Drop for BackgroundServer {
    fn drop(&mut self) {
        self.task.abort();
    }
}

async fn start_postgres_server(catalog_path: &str) -> (BackgroundServer, String) {
    eprintln!(
        "[TRACE] start_postgres_server: starting for {}",
        catalog_path
    );
    let listener = TcpListener::bind("127.0.0.1:0")
        .await
        .expect("listener should bind");
    let addr = listener.local_addr().expect("local addr should exist");
    eprintln!("[TRACE] start_postgres_server: bound to {}", addr);
    let engine = Arc::new(
        PrototypeEngine::from_catalog_path(catalog_path)
            .await
            .expect("engine should initialize"),
    );
    eprintln!("[TRACE] start_postgres_server: engine initialized");
    let task = tokio::spawn(serve_postgres_wire(listener, engine));

    tokio::time::sleep(Duration::from_millis(50)).await;
    eprintln!("[TRACE] start_postgres_server: ready");

    (
        BackgroundServer { task },
        format!("127.0.0.1:{}", addr.port()),
    )
}

struct FlightBackgroundServer {
    task: tokio::task::JoinHandle<anyhow::Result<()>>,
}

impl Drop for FlightBackgroundServer {
    fn drop(&mut self) {
        self.task.abort();
    }
}

async fn start_flight_sql_server(catalog_path: &str) -> (FlightBackgroundServer, String) {
    let listener = TcpListener::bind("127.0.0.1:0")
        .await
        .expect("listener should bind");
    let addr = listener.local_addr().expect("local addr should exist");
    let engine = Arc::new(
        PrototypeEngine::from_catalog_path(catalog_path)
            .await
            .expect("engine should initialize"),
    );
    let task = tokio::spawn(serve_flight_sql(listener, engine, None));

    tokio::time::sleep(Duration::from_millis(50)).await;

    (
        FlightBackgroundServer { task },
        format!("http://127.0.0.1:{}", addr.port()),
    )
}

fn cli_json_response(mut command: Command) -> QueryResponse {
    let output = command.assert().success().get_output().clone();
    eprintln!("{}", String::from_utf8_lossy(&output.stderr));

    serde_json::from_slice(&output.stdout).expect("stdout should be a JSON query response")
}

fn protocol_json_response(
    protocol: &str,
    endpoint: &str,
    schema: Option<&str>,
    sql: &str,
) -> QueryResponse {
    protocol_json_response_with_context(protocol, endpoint, None, schema, sql)
}

fn protocol_json_response_with_context(
    protocol: &str,
    endpoint: &str,
    database: Option<&str>,
    schema: Option<&str>,
    sql: &str,
) -> QueryResponse {
    protocol_json_response_with_auth_context(
        protocol,
        endpoint,
        database,
        schema,
        "postgres",
        None,
        Some("postgres"),
        sql,
    )
}

fn protocol_json_response_with_auth_context(
    protocol: &str,
    endpoint: &str,
    database: Option<&str>,
    schema: Option<&str>,
    user: &str,
    role: Option<&str>,
    password: Option<&str>,
    sql: &str,
) -> QueryResponse {
    let mut command = Command::cargo_bin("analyticsdb").expect("binary should build");
    command.args([
        "query",
        "--format",
        "json",
        "--protocol",
        protocol,
        "--endpoint",
        endpoint,
        "--user",
        user,
        "--sql",
        sql,
    ]);

    if let Some(database) = database {
        command.args(["--database", database]);
    }
    if let Some(schema) = schema {
        command.args(["--schema", schema]);
    }
    if let Some(role) = role {
        command.args(["--role", role]);
    }
    if let Some(password) = password {
        command.args(["--password", password]);
    }

    cli_json_response(command)
}

fn protocol_stderr_failure(
    protocol: &str,
    endpoint: &str,
    database: Option<&str>,
    schema: Option<&str>,
    sql: &str,
) -> String {
    protocol_stderr_failure_with_auth_context(
        protocol,
        endpoint,
        database,
        schema,
        "postgres",
        None,
        Some("postgres"),
        sql,
    )
}

fn protocol_stderr_failure_with_auth_context(
    protocol: &str,
    endpoint: &str,
    database: Option<&str>,
    schema: Option<&str>,
    user: &str,
    role: Option<&str>,
    password: Option<&str>,
    sql: &str,
) -> String {
    let mut command = Command::cargo_bin("analyticsdb").expect("binary should build");
    command.args([
        "query",
        "--protocol",
        protocol,
        "--endpoint",
        endpoint,
        "--user",
        user,
        "--sql",
        sql,
    ]);

    if let Some(database) = database {
        command.args(["--database", database]);
    }
    if let Some(schema) = schema {
        command.args(["--schema", schema]);
    }
    if let Some(role) = role {
        command.args(["--role", role]);
    }
    if let Some(password) = password {
        command.args(["--password", password]);
    }

    let stderr = command.assert().failure().get_output().stderr.clone();

    String::from_utf8(stderr).expect("stderr should be valid utf-8")
}

#[tokio::test(flavor = "multi_thread")]
async fn cli_protocols_surface_session_auth_metadata_slice() {
    let catalog_path = temp_catalog_path();
    let (_postgres_server, postgres_endpoint) = start_postgres_server(&catalog_path).await;
    let (_flight_server, flight_endpoint) = start_flight_sql_server(&catalog_path).await;

    let postgres = protocol_json_response_with_auth_context(
        "postgres",
        &postgres_endpoint,
        None,
        Some("public"),
        "postgres",
        Some("postgres"),
        Some("postgres"),
        "SELECT 1 AS one",
    );
    let flight = protocol_json_response_with_auth_context(
        "flight-sql",
        &flight_endpoint,
        None,
        Some("public"),
        "postgres",
        Some("postgres"),
        Some("postgres"),
        "SELECT 1 AS one",
    );

    assert_eq!(postgres.session.user, flight.session.user);
    assert_eq!(postgres.session.role, flight.session.role);
    assert_eq!(postgres.session.database, flight.session.database);
    assert_eq!(postgres.session.schema, flight.session.schema);
    assert_eq!(postgres.rows, flight.rows);
    assert_eq!(postgres.columns, flight.columns);
    assert_eq!(postgres.session.user, "postgres");
    assert_eq!(postgres.session.role, "postgres");
    assert_eq!(postgres.session.auth_method, "postgres-wire-startup");
    assert_eq!(flight.session.auth_method, "flight-sql-header");

    cleanup_catalog_artifacts(&catalog_path);
}

#[tokio::test(flavor = "multi_thread")]
async fn cli_protocols_share_unknown_user_auth_failure_contract() {
    let catalog_path = temp_catalog_path();
    let (_postgres_server, postgres_endpoint) = start_postgres_server(&catalog_path).await;
    let (_flight_server, flight_endpoint) = start_flight_sql_server(&catalog_path).await;

    let postgres_stderr = protocol_stderr_failure_with_auth_context(
        "postgres",
        &postgres_endpoint,
        None,
        Some("public"),
        "missing_user",
        None,
        Some("secret"),
        "SELECT 1 AS one",
    );
    let flight_stderr = protocol_stderr_failure_with_auth_context(
        "flight-sql",
        &flight_endpoint,
        None,
        Some("public"),
        "missing_user",
        None,
        Some("secret"),
        "SELECT 1 AS one",
    );

    assert!(
        postgres_stderr.contains("Unknown user 'missing_user'"),
        "postgres stderr={postgres_stderr}"
    );
    assert!(
        flight_stderr.contains("Unknown user 'missing_user'"),
        "flight stderr={flight_stderr}"
    );

    cleanup_catalog_artifacts(&catalog_path);
}

#[tokio::test(flavor = "multi_thread")]
async fn cli_protocols_password_matrix_valid_and_invalid_cases() {
    let catalog_path = temp_catalog_path();
    let (_postgres_server, postgres_endpoint) = start_postgres_server(&catalog_path).await;
    let (_flight_server, flight_endpoint) = start_flight_sql_server(&catalog_path).await;

    let postgres_ok = protocol_json_response_with_auth_context(
        "postgres",
        &postgres_endpoint,
        None,
        Some("public"),
        "postgres",
        Some("postgres"),
        Some("postgres"),
        "SELECT 1 AS one",
    );
    let flight_ok = protocol_json_response_with_auth_context(
        "flight-sql",
        &flight_endpoint,
        None,
        Some("public"),
        "postgres",
        Some("postgres"),
        Some("postgres"),
        "SELECT 1 AS one",
    );
    assert_eq!(postgres_ok.rows, flight_ok.rows);

    let postgres_wrong_password = protocol_stderr_failure_with_auth_context(
        "postgres",
        &postgres_endpoint,
        None,
        Some("public"),
        "postgres",
        Some("postgres"),
        Some("wrong-password"),
        "SELECT 1 AS one",
    );
    let flight_wrong_password = protocol_stderr_failure_with_auth_context(
        "flight-sql",
        &flight_endpoint,
        None,
        Some("public"),
        "postgres",
        Some("postgres"),
        Some("wrong-password"),
        "SELECT 1 AS one",
    );
    let postgres_wrong_password_lower = postgres_wrong_password.to_ascii_lowercase();
    assert!(
        postgres_wrong_password_lower.contains("password")
            || postgres_wrong_password.contains("Invalid credentials"),
        "postgres stderr={postgres_wrong_password}"
    );
    assert!(
        flight_wrong_password.contains("Invalid credentials"),
        "flight stderr={flight_wrong_password}"
    );

    let postgres_reader_ok = protocol_json_response_with_auth_context(
        "postgres",
        &postgres_endpoint,
        None,
        Some("public"),
        "analytics_reader",
        Some("analytics_reader"),
        Some("analytics_reader"),
        "SELECT 1 AS one",
    );
    let flight_reader_ok = protocol_json_response_with_auth_context(
        "flight-sql",
        &flight_endpoint,
        None,
        Some("public"),
        "analytics_reader",
        Some("analytics_reader"),
        Some("analytics_reader"),
        "SELECT 1 AS one",
    );
    assert_eq!(postgres_reader_ok.rows, flight_reader_ok.rows);

    cleanup_catalog_artifacts(&catalog_path);
}

#[tokio::test(flavor = "multi_thread")]
async fn cli_password_rotation_invalidates_old_credentials_across_protocols() {
    let catalog_path = temp_catalog_path();

    {
        let (_postgres_server, postgres_endpoint) = start_postgres_server(&catalog_path).await;
        let (_flight_server, flight_endpoint) = start_flight_sql_server(&catalog_path).await;

        let postgres_before = protocol_json_response_with_auth_context(
            "postgres",
            &postgres_endpoint,
            None,
            Some("public"),
            "analytics_reader",
            Some("analytics_reader"),
            Some("analytics_reader"),
            "SELECT 1 AS one",
        );
        let flight_before = protocol_json_response_with_auth_context(
            "flight-sql",
            &flight_endpoint,
            None,
            Some("public"),
            "analytics_reader",
            Some("analytics_reader"),
            Some("analytics_reader"),
            "SELECT 1 AS one",
        );
        assert_eq!(postgres_before.rows, flight_before.rows);

        let _ = protocol_json_response_with_auth_context(
            "postgres",
            &postgres_endpoint,
            None,
            Some("public"),
            "postgres",
            Some("postgres"),
            Some("postgres"),
            "ALTER USER analytics_reader PASSWORD 'reader-rotated-via-postgres'",
        );
    }

    {
        let (_postgres_server, postgres_endpoint) = start_postgres_server(&catalog_path).await;
        let (_flight_server, flight_endpoint) = start_flight_sql_server(&catalog_path).await;

        let postgres_old_after_postgres_rotation = protocol_stderr_failure_with_auth_context(
            "postgres",
            &postgres_endpoint,
            None,
            Some("public"),
            "analytics_reader",
            Some("analytics_reader"),
            Some("analytics_reader"),
            "SELECT 1 AS one",
        );
        let flight_old_after_postgres_rotation = protocol_stderr_failure_with_auth_context(
            "flight-sql",
            &flight_endpoint,
            None,
            Some("public"),
            "analytics_reader",
            Some("analytics_reader"),
            Some("analytics_reader"),
            "SELECT 1 AS one",
        );
        assert!(
            postgres_old_after_postgres_rotation
                .to_ascii_lowercase()
                .contains("password")
                || postgres_old_after_postgres_rotation.contains("Invalid credentials"),
            "postgres stderr={postgres_old_after_postgres_rotation}"
        );
        assert!(
            flight_old_after_postgres_rotation.contains("Invalid credentials"),
            "flight stderr={flight_old_after_postgres_rotation}"
        );

        let postgres_new_after_postgres_rotation = protocol_json_response_with_auth_context(
            "postgres",
            &postgres_endpoint,
            None,
            Some("public"),
            "analytics_reader",
            Some("analytics_reader"),
            Some("reader-rotated-via-postgres"),
            "SELECT 1 AS one",
        );
        let flight_new_after_postgres_rotation = protocol_json_response_with_auth_context(
            "flight-sql",
            &flight_endpoint,
            None,
            Some("public"),
            "analytics_reader",
            Some("analytics_reader"),
            Some("reader-rotated-via-postgres"),
            "SELECT 1 AS one",
        );
        assert_eq!(
            postgres_new_after_postgres_rotation.rows,
            flight_new_after_postgres_rotation.rows
        );

        let _ = protocol_json_response_with_auth_context(
            "flight-sql",
            &flight_endpoint,
            None,
            Some("public"),
            "postgres",
            Some("postgres"),
            Some("postgres"),
            "ALTER USER analytics_reader PASSWORD 'reader-rotated-via-flight'",
        );
    }

    {
        let (_postgres_server, postgres_endpoint) = start_postgres_server(&catalog_path).await;
        let (_flight_server, flight_endpoint) = start_flight_sql_server(&catalog_path).await;

        let postgres_old_after_flight_rotation = protocol_stderr_failure_with_auth_context(
            "postgres",
            &postgres_endpoint,
            None,
            Some("public"),
            "analytics_reader",
            Some("analytics_reader"),
            Some("reader-rotated-via-postgres"),
            "SELECT 1 AS one",
        );
        let flight_old_after_flight_rotation = protocol_stderr_failure_with_auth_context(
            "flight-sql",
            &flight_endpoint,
            None,
            Some("public"),
            "analytics_reader",
            Some("analytics_reader"),
            Some("reader-rotated-via-postgres"),
            "SELECT 1 AS one",
        );
        assert!(
            postgres_old_after_flight_rotation
                .to_ascii_lowercase()
                .contains("password")
                || postgres_old_after_flight_rotation.contains("Invalid credentials"),
            "postgres stderr={postgres_old_after_flight_rotation}"
        );
        assert!(
            flight_old_after_flight_rotation.contains("Invalid credentials"),
            "flight stderr={flight_old_after_flight_rotation}"
        );

        let postgres_new_after_flight_rotation = protocol_json_response_with_auth_context(
            "postgres",
            &postgres_endpoint,
            None,
            Some("public"),
            "analytics_reader",
            Some("analytics_reader"),
            Some("reader-rotated-via-flight"),
            "SELECT 1 AS one",
        );
        let flight_new_after_flight_rotation = protocol_json_response_with_auth_context(
            "flight-sql",
            &flight_endpoint,
            None,
            Some("public"),
            "analytics_reader",
            Some("analytics_reader"),
            Some("reader-rotated-via-flight"),
            "SELECT 1 AS one",
        );
        assert_eq!(
            postgres_new_after_flight_rotation.rows,
            flight_new_after_flight_rotation.rows
        );
    }

    cleanup_catalog_artifacts(&catalog_path);
}

fn assert_supported_protocol_error_equivalence(
    step: &str,
    postgres_stderr: &str,
    flight_stderr: &str,
    expected_message_substring: &str,
) {
    assert!(
        postgres_stderr.contains("ERROR: Remote query execution failed:"),
        "{step}: postgres stderr={postgres_stderr}"
    );
    assert!(
        flight_stderr.contains("ERROR: Remote query execution failed:"),
        "{step}: flight stderr={flight_stderr}"
    );
    assert!(
        postgres_stderr.contains(expected_message_substring),
        "{step}: postgres stderr={postgres_stderr}"
    );
    assert!(
        flight_stderr.contains(expected_message_substring),
        "{step}: flight stderr={flight_stderr}"
    );
}

fn assert_supported_protocol_command_error_equivalence(
    step: &str,
    postgres_stderr: &str,
    flight_stderr: &str,
    expected_message_substring: &str,
) {
    assert!(
        postgres_stderr.contains("ERROR: Remote command execution failed:"),
        "{step}: postgres stderr={postgres_stderr}"
    );
    assert!(
        flight_stderr.contains("ERROR: Remote command execution failed:"),
        "{step}: flight stderr={flight_stderr}"
    );
    assert!(
        postgres_stderr.contains(expected_message_substring),
        "{step}: postgres stderr={postgres_stderr}"
    );
    assert!(
        flight_stderr.contains(expected_message_substring),
        "{step}: flight stderr={flight_stderr}"
    );
}

fn assert_supported_protocol_command_error_contains_any(
    step: &str,
    postgres_stderr: &str,
    flight_stderr: &str,
    keywords: &[&str],
) {
    assert!(
        postgres_stderr.contains("ERROR: Remote command execution failed:"),
        "{step}: postgres stderr={postgres_stderr}"
    );
    assert!(
        flight_stderr.contains("ERROR: Remote command execution failed:"),
        "{step}: flight stderr={flight_stderr}"
    );

    let postgres_match = keywords
        .iter()
        .any(|needle| postgres_stderr.contains(needle));
    let flight_match = keywords.iter().any(|needle| flight_stderr.contains(needle));
    assert!(
        postgres_match,
        "{step}: postgres stderr did not match any keyword {keywords:?}; stderr={postgres_stderr}"
    );
    assert!(
        flight_match,
        "{step}: flight stderr did not match any keyword {keywords:?}; stderr={flight_stderr}"
    );
}

fn assert_supported_protocol_equivalence(
    step: &str,
    postgres: &QueryResponse,
    flight_sql: &QueryResponse,
) {
    assert_eq!(
        postgres.session.user, flight_sql.session.user,
        "{step}: user"
    );
    assert_eq!(
        postgres.session.database, flight_sql.session.database,
        "{step}: database"
    );
    assert_eq!(
        postgres.session.schema, flight_sql.session.schema,
        "{step}: schema"
    );
    assert_eq!(postgres.columns, flight_sql.columns, "{step}: columns");
    assert_eq!(postgres.rows, flight_sql.rows, "{step}: rows");
    assert_eq!(postgres.message, flight_sql.message, "{step}: message");
}

#[tokio::test(flavor = "multi_thread")]
async fn cli_executes_sql_and_reports_timing() {
    let catalog_path = temp_catalog_path();
    let output = Command::cargo_bin("analyticsdb")
        .expect("binary should build")
        .args([
            "query",
            "--catalog-path",
            &catalog_path,
            "--sql",
            "SELECT 1 AS one, 2 AS two",
        ])
        .assert()
        .success()
        .get_output()
        .stdout
        .clone();

    let stdout = String::from_utf8(output).expect("stdout should be valid utf-8");

    assert!(stdout.contains("Query ID: q-"));
    assert!(stdout.contains("Coordinator: control-1"));
    assert!(stdout.contains("Session: user=postgres database=postgres schema=public"));
    assert!(stdout.contains("Message: Query executed successfully."));
    assert!(stdout.contains("Execution Time:"));
    assert!(stdout.contains("| one | two |"));
    assert!(stdout.contains("| 1   | 2   |"));
    assert!(stdout.contains("Rows: 1"));

    cleanup_catalog_artifacts(&catalog_path);
}

