#[tokio::test(flavor = "multi_thread")]
async fn cli_protocols_share_schema_scoped_sql_and_metadata_slice() {
    let postgres_catalog_path = temp_catalog_path();
    let flight_catalog_path = temp_catalog_path();
    let (_postgres_server, postgres_endpoint) = start_postgres_server(&postgres_catalog_path).await;
    let (_flight_server, flight_endpoint) = start_flight_sql_server(&flight_catalog_path).await;

    let postgres_create_schema = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        None,
        "CREATE SCHEMA reporting",
    );
    let flight_create_schema = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        None,
        "CREATE SCHEMA reporting",
    );
    assert_supported_protocol_equivalence(
        "create schema",
        &postgres_create_schema,
        &flight_create_schema,
    );

    let postgres_create_table = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        Some("reporting"),
        "CREATE TABLE fact_metrics (metric BIGINT NOT NULL, status TEXT, score DOUBLE PRECISION)",
    );
    let flight_create_table = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        Some("reporting"),
        "CREATE TABLE fact_metrics (metric BIGINT NOT NULL, status TEXT, score DOUBLE PRECISION)",
    );
    assert_supported_protocol_equivalence(
        "create table",
        &postgres_create_table,
        &flight_create_table,
    );

    let postgres_insert = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        Some("reporting"),
        "INSERT INTO fact_metrics (metric, status) VALUES (11, 'ok')",
    );
    let flight_insert = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        Some("reporting"),
        "INSERT INTO fact_metrics (metric, status) VALUES (11, 'ok')",
    );
    assert_supported_protocol_equivalence("insert", &postgres_insert, &flight_insert);

    let postgres_query = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        Some("reporting"),
        "SELECT metric, status, score FROM fact_metrics ORDER BY metric",
    );
    let flight_query = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        Some("reporting"),
        "SELECT metric, status, score FROM fact_metrics ORDER BY metric",
    );
    assert_supported_protocol_equivalence("query rows", &postgres_query, &flight_query);

    let postgres_empty_query = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        Some("reporting"),
        "SELECT metric, status FROM fact_metrics WHERE metric = 999",
    );
    let flight_empty_query = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        Some("reporting"),
        "SELECT metric, status FROM fact_metrics WHERE metric = 999",
    );
    assert_supported_protocol_equivalence(
        "query empty result",
        &postgres_empty_query,
        &flight_empty_query,
    );

    let postgres_show_tables = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        None,
        "SHOW TABLES FROM reporting",
    );
    let flight_show_tables = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        None,
        "SHOW TABLES FROM reporting",
    );
    assert_supported_protocol_equivalence(
        "show tables",
        &postgres_show_tables,
        &flight_show_tables,
    );

    let postgres_show_columns = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        Some("reporting"),
        "SHOW COLUMNS FROM fact_metrics",
    );
    let flight_show_columns = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        Some("reporting"),
        "SHOW COLUMNS FROM fact_metrics",
    );
    assert_supported_protocol_equivalence(
        "show columns",
        &postgres_show_columns,
        &flight_show_columns,
    );

    let postgres_describe = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        Some("reporting"),
        "DESCRIBE fact_metrics",
    );
    let flight_describe = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        Some("reporting"),
        "DESCRIBE fact_metrics",
    );
    assert_supported_protocol_equivalence("describe", &postgres_describe, &flight_describe);

    let postgres_create_view = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        Some("reporting"),
        "CREATE VIEW daily_metrics AS SELECT metric, status FROM fact_metrics",
    );
    let flight_create_view = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        Some("reporting"),
        "CREATE VIEW daily_metrics AS SELECT metric, status FROM fact_metrics",
    );
    assert_supported_protocol_equivalence(
        "create view",
        &postgres_create_view,
        &flight_create_view,
    );

    let postgres_show_views = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        None,
        "SHOW VIEWS FROM reporting",
    );
    let flight_show_views = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        None,
        "SHOW VIEWS FROM reporting",
    );
    assert_supported_protocol_equivalence("show views", &postgres_show_views, &flight_show_views);

    let postgres_view_query = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        Some("reporting"),
        "SELECT metric, status FROM daily_metrics",
    );
    let flight_view_query = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        Some("reporting"),
        "SELECT metric, status FROM daily_metrics",
    );
    assert_supported_protocol_equivalence("query view", &postgres_view_query, &flight_view_query);

    cleanup_catalog_artifacts(&postgres_catalog_path);
    cleanup_catalog_artifacts(&flight_catalog_path);
}

#[tokio::test(flavor = "multi_thread")]
async fn cli_protocols_share_user_visible_query_error_slice() {
    let postgres_catalog_path = temp_catalog_path();
    let flight_catalog_path = temp_catalog_path();
    let (_postgres_server, postgres_endpoint) = start_postgres_server(&postgres_catalog_path).await;
    let (_flight_server, flight_endpoint) = start_flight_sql_server(&flight_catalog_path).await;

    let postgres_unknown_database = protocol_stderr_failure(
        "postgres",
        &postgres_endpoint,
        Some("missing"),
        None,
        "SELECT 1 AS one",
    );
    let flight_unknown_database = protocol_stderr_failure(
        "flight-sql",
        &flight_endpoint,
        Some("missing"),
        None,
        "SELECT 1 AS one",
    );
    assert_supported_protocol_error_equivalence(
        "unknown database",
        &postgres_unknown_database,
        &flight_unknown_database,
        "Unknown database 'missing'",
    );

    let postgres_unknown_schema = protocol_stderr_failure(
        "postgres",
        &postgres_endpoint,
        None,
        Some("reporting"),
        "SELECT 1 AS one",
    );
    let flight_unknown_schema = protocol_stderr_failure(
        "flight-sql",
        &flight_endpoint,
        None,
        Some("reporting"),
        "SELECT 1 AS one",
    );
    assert_supported_protocol_error_equivalence(
        "unknown schema",
        &postgres_unknown_schema,
        &flight_unknown_schema,
        "Unknown schema 'postgres.reporting'",
    );

    cleanup_catalog_artifacts(&postgres_catalog_path);
    cleanup_catalog_artifacts(&flight_catalog_path);
}

#[tokio::test(flavor = "multi_thread")]
async fn cli_protocols_share_user_visible_command_error_slice() {
    let postgres_catalog_path = temp_catalog_path();
    let flight_catalog_path = temp_catalog_path();
    let (_postgres_server, postgres_endpoint) = start_postgres_server(&postgres_catalog_path).await;
    let (_flight_server, flight_endpoint) = start_flight_sql_server(&flight_catalog_path).await;

    let _ = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        None,
        "CREATE TABLE fact_metrics (metric BIGINT NOT NULL, status TEXT)",
    );
    let _ = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        None,
        "CREATE TABLE fact_metrics (metric BIGINT NOT NULL, status TEXT)",
    );

    let postgres_duplicate_create = protocol_stderr_failure(
        "postgres",
        &postgres_endpoint,
        None,
        None,
        "CREATE TABLE fact_metrics (metric BIGINT NOT NULL, status TEXT)",
    );
    let flight_duplicate_create = protocol_stderr_failure(
        "flight-sql",
        &flight_endpoint,
        None,
        None,
        "CREATE TABLE fact_metrics (metric BIGINT NOT NULL, status TEXT)",
    );
    assert_supported_protocol_command_error_equivalence(
        "duplicate create table",
        &postgres_duplicate_create,
        &flight_duplicate_create,
        "Relation 'postgres.public.fact_metrics' already exists",
    );

    let postgres_not_null_insert = protocol_stderr_failure(
        "postgres",
        &postgres_endpoint,
        None,
        None,
        "INSERT INTO fact_metrics (status) VALUES ('ok')",
    );
    let flight_not_null_insert = protocol_stderr_failure(
        "flight-sql",
        &flight_endpoint,
        None,
        None,
        "INSERT INTO fact_metrics (status) VALUES ('ok')",
    );
    assert_supported_protocol_command_error_equivalence(
        "not-null insert",
        &postgres_not_null_insert,
        &flight_not_null_insert,
        "Column 'metric' must be provided because it is NOT NULL",
    );

    let postgres_wrong_value_count = protocol_stderr_failure(
        "postgres",
        &postgres_endpoint,
        None,
        None,
        "INSERT INTO fact_metrics VALUES (11)",
    );
    let flight_wrong_value_count = protocol_stderr_failure(
        "flight-sql",
        &flight_endpoint,
        None,
        None,
        "INSERT INTO fact_metrics VALUES (11)",
    );
    assert_supported_protocol_command_error_equivalence(
        "insert wrong value count",
        &postgres_wrong_value_count,
        &flight_wrong_value_count,
        "Expected 2 value(s) per row, found 1",
    );

    cleanup_catalog_artifacts(&postgres_catalog_path);
    cleanup_catalog_artifacts(&flight_catalog_path);
}

#[tokio::test(flavor = "multi_thread")]
async fn cli_protocols_share_cross_database_schema_sql_slice() {
    let postgres_catalog_path = temp_catalog_path();
    let flight_catalog_path = temp_catalog_path();
    let (_postgres_server, postgres_endpoint) = start_postgres_server(&postgres_catalog_path).await;
    let (_flight_server, flight_endpoint) = start_flight_sql_server(&flight_catalog_path).await;

    let postgres_create_database = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        None,
        "CREATE DATABASE analytics",
    );
    let flight_create_database = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        None,
        "CREATE DATABASE analytics",
    );
    assert_supported_protocol_equivalence(
        "create database",
        &postgres_create_database,
        &flight_create_database,
    );

    let postgres_show_databases =
        protocol_json_response("postgres", &postgres_endpoint, None, "SHOW DATABASES");
    let flight_show_databases =
        protocol_json_response("flight-sql", &flight_endpoint, None, "SHOW DATABASES");
    assert_supported_protocol_equivalence(
        "show databases",
        &postgres_show_databases,
        &flight_show_databases,
    );

    let postgres_create_schema = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        None,
        "CREATE SCHEMA analytics.reporting",
    );
    let flight_create_schema = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        None,
        "CREATE SCHEMA analytics.reporting",
    );
    assert_supported_protocol_equivalence(
        "create qualified schema",
        &postgres_create_schema,
        &flight_create_schema,
    );

    let postgres_show_schemas = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        None,
        "SHOW SCHEMAS FROM analytics",
    );
    let flight_show_schemas = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        None,
        "SHOW SCHEMAS FROM analytics",
    );
    assert_supported_protocol_equivalence(
        "show schemas from database",
        &postgres_show_schemas,
        &flight_show_schemas,
    );

    let postgres_create_table = protocol_json_response_with_context(
        "postgres",
        &postgres_endpoint,
        Some("analytics"),
        None,
        "CREATE TABLE reporting.fact_metrics (metric BIGINT NOT NULL, status TEXT, active BOOLEAN)",
    );
    let flight_create_table = protocol_json_response_with_context(
        "flight-sql",
        &flight_endpoint,
        Some("analytics"),
        None,
        "CREATE TABLE reporting.fact_metrics (metric BIGINT NOT NULL, status TEXT, active BOOLEAN)",
    );
    assert_supported_protocol_equivalence(
        "create qualified table",
        &postgres_create_table,
        &flight_create_table,
    );

    let postgres_insert = protocol_json_response_with_context(
        "postgres",
        &postgres_endpoint,
        Some("analytics"),
        None,
        "INSERT INTO reporting.fact_metrics (metric, active, status) VALUES (11, true, 'ok''s')",
    );
    let flight_insert = protocol_json_response_with_context(
        "flight-sql",
        &flight_endpoint,
        Some("analytics"),
        None,
        "INSERT INTO reporting.fact_metrics (metric, active, status) VALUES (11, true, 'ok''s')",
    );
    assert_supported_protocol_equivalence(
        "qualified insert column list",
        &postgres_insert,
        &flight_insert,
    );

    let postgres_show_tables = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        None,
        "SHOW TABLES FROM analytics.reporting",
    );
    let flight_show_tables = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        None,
        "SHOW TABLES FROM analytics.reporting",
    );
    assert_supported_protocol_equivalence(
        "show tables from qualified schema",
        &postgres_show_tables,
        &flight_show_tables,
    );

    cleanup_catalog_artifacts(&postgres_catalog_path);
    cleanup_catalog_artifacts(&flight_catalog_path);
}

#[tokio::test(flavor = "multi_thread")]
async fn cli_protocols_share_missing_relation_query_error_slice() {
    let postgres_catalog_path = temp_catalog_path();
    let flight_catalog_path = temp_catalog_path();
    let (_postgres_server, postgres_endpoint) = start_postgres_server(&postgres_catalog_path).await;
    let (_flight_server, flight_endpoint) = start_flight_sql_server(&flight_catalog_path).await;

    let _ = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        None,
        "CREATE SCHEMA reporting",
    );
    let _ = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        None,
        "CREATE SCHEMA reporting",
    );

    let postgres_missing_relation = protocol_stderr_failure(
        "postgres",
        &postgres_endpoint,
        None,
        Some("reporting"),
        "SELECT * FROM missing_table",
    );
    let flight_missing_relation = protocol_stderr_failure(
        "flight-sql",
        &flight_endpoint,
        None,
        Some("reporting"),
        "SELECT * FROM missing_table",
    );

    assert_supported_protocol_error_equivalence(
        "missing relation in existing schema",
        &postgres_missing_relation,
        &flight_missing_relation,
        "not found",
    );

    cleanup_catalog_artifacts(&postgres_catalog_path);
    cleanup_catalog_artifacts(&flight_catalog_path);
}

#[tokio::test(flavor = "multi_thread")]
async fn cli_protocols_expose_pg_catalog_metadata_slice() {
    let postgres_catalog_path = temp_catalog_path();
    let flight_catalog_path = temp_catalog_path();
    let (_postgres_server, postgres_endpoint) = start_postgres_server(&postgres_catalog_path).await;
    let (_flight_server, flight_endpoint) = start_flight_sql_server(&flight_catalog_path).await;

    let _ = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        None,
        "CREATE SCHEMA reporting",
    );
    let _ = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        None,
        "CREATE SCHEMA reporting",
    );
    let _ = protocol_json_response("postgres", &postgres_endpoint, None, "CREATE SCHEMA alpha");
    let _ = protocol_json_response("flight-sql", &flight_endpoint, None, "CREATE SCHEMA alpha");
    let _ = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        Some("reporting"),
        "CREATE TABLE fact_metrics (metric BIGINT NOT NULL, status TEXT)",
    );
    let _ = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        Some("reporting"),
        "CREATE TABLE fact_metrics (metric BIGINT NOT NULL, status TEXT)",
    );
    let _ = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        Some("reporting"),
        "CREATE VIEW daily_metrics AS SELECT metric, status FROM fact_metrics",
    );
    let _ = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        Some("reporting"),
        "CREATE VIEW daily_metrics AS SELECT metric, status FROM fact_metrics",
    );
    let _ = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        Some("reporting"),
        "CREATE TABLE dim_metrics (metric BIGINT NOT NULL, label TEXT, CONSTRAINT dim_metrics_pkey PRIMARY KEY (metric))",
    );
    let _ = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        Some("reporting"),
        "CREATE TABLE dim_metrics (metric BIGINT NOT NULL, label TEXT, CONSTRAINT dim_metrics_pkey PRIMARY KEY (metric))",
    );
    let _ = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        Some("reporting"),
        "CREATE TABLE fact_events (metric_id BIGINT NOT NULL, CONSTRAINT fact_events_metric_fk FOREIGN KEY (metric_id) REFERENCES reporting.dim_metrics(metric))",
    );
    let _ = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        Some("reporting"),
        "CREATE TABLE fact_events (metric_id BIGINT NOT NULL, CONSTRAINT fact_events_metric_fk FOREIGN KEY (metric_id) REFERENCES reporting.dim_metrics(metric))",
    );
    let _ = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        Some("alpha"),
        "CREATE TABLE fact_alpha (metric BIGINT NOT NULL, status TEXT)",
    );
    let _ = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        Some("alpha"),
        "CREATE TABLE fact_alpha (metric BIGINT NOT NULL, status TEXT)",
    );
    let _ = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        Some("alpha"),
        "CREATE VIEW daily_alpha AS SELECT metric, status FROM fact_alpha",
    );
    let _ = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        Some("alpha"),
        "CREATE VIEW daily_alpha AS SELECT metric, status FROM fact_alpha",
    );

    let pg_tables = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        None,
        "SELECT * FROM pg_catalog.pg_tables",
    );
    let fl_tables = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        None,
        "SELECT * FROM pg_catalog.pg_tables",
    );
    assert_eq!(
        pg_tables.columns,
        vec![
            "schemaname",
            "tablename",
            "tableowner",
            "tablespace",
            "hasindexes",
            "hasrules",
            "hastriggers",
            "rowsecurity",
        ]
    );
    assert_eq!(pg_tables.columns, fl_tables.columns);
    assert!(
        pg_tables.rows.iter().any(|row| {
            row.first() == Some(&"reporting".to_string())
                && row.get(1) == Some(&"fact_metrics".to_string())
        }),
        "postgres pg_tables rows={:?}",
        pg_tables.rows
    );
    assert!(
        fl_tables.rows.iter().any(|row| {
            row.first() == Some(&"reporting".to_string())
                && row.get(1) == Some(&"fact_metrics".to_string())
        }),
        "flight pg_tables rows={:?}",
        fl_tables.rows
    );

    let pg_views = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        None,
        "SELECT * FROM pg_catalog.pg_views",
    );
    let fl_views = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        None,
        "SELECT * FROM pg_catalog.pg_views",
    );
    assert_eq!(
        pg_views.columns,
        vec!["schemaname", "viewname", "viewowner", "definition"]
    );
    assert_eq!(pg_views.columns, fl_views.columns);
    assert!(
        pg_views.rows.iter().any(|row| {
            row.first() == Some(&"reporting".to_string())
                && row.get(1) == Some(&"daily_metrics".to_string())
        }),
        "postgres pg_views rows={:?}",
        pg_views.rows
    );
    assert!(
        fl_views.rows.iter().any(|row| {
            row.first() == Some(&"reporting".to_string())
                && row.get(1) == Some(&"daily_metrics".to_string())
        }),
        "flight pg_views rows={:?}",
        fl_views.rows
    );

    let pg_namespace = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        None,
        "SELECT * FROM pg_catalog.pg_namespace",
    );
    let fl_namespace = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        None,
        "SELECT * FROM pg_catalog.pg_namespace",
    );
    assert_eq!(
        pg_namespace.columns,
        vec!["oid", "nspname", "nspowner", "nspacl"]
    );
    assert_eq!(pg_namespace.columns, fl_namespace.columns);
    assert!(
        pg_namespace
            .rows
            .iter()
            .any(|row| row.get(1) == Some(&"public".to_string())),
        "postgres pg_namespace rows={:?}",
        pg_namespace.rows
    );
    assert!(
        fl_namespace
            .rows
            .iter()
            .any(|row| row.get(1) == Some(&"public".to_string())),
        "flight pg_namespace rows={:?}",
        fl_namespace.rows
    );

    let pg_filtered_tables = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        None,
        "SELECT schemaname, tablename FROM pg_catalog.pg_tables WHERE schemaname = 'reporting' ORDER BY tablename",
    );
    let fl_filtered_tables = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        None,
        "SELECT schemaname, tablename FROM pg_catalog.pg_tables WHERE schemaname = 'reporting' ORDER BY tablename",
    );
    assert_eq!(pg_filtered_tables.columns, vec!["schemaname", "tablename"]);
    assert_eq!(pg_filtered_tables.columns, fl_filtered_tables.columns);
    assert_eq!(
        pg_filtered_tables.rows,
        vec![
            vec!["reporting".to_string(), "dim_metrics".to_string()],
            vec!["reporting".to_string(), "fact_events".to_string()],
            vec!["reporting".to_string(), "fact_metrics".to_string()],
        ]
    );
    assert_eq!(pg_filtered_tables.rows, fl_filtered_tables.rows);

    let pg_filtered_views = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        None,
        "SELECT schemaname, viewname FROM pg_catalog.pg_views WHERE schemaname = 'reporting' ORDER BY viewname",
    );
    let fl_filtered_views = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        None,
        "SELECT schemaname, viewname FROM pg_catalog.pg_views WHERE schemaname = 'reporting' ORDER BY viewname",
    );
    assert_eq!(pg_filtered_views.columns, vec!["schemaname", "viewname"]);
    assert_eq!(pg_filtered_views.columns, fl_filtered_views.columns);
    assert_eq!(
        pg_filtered_views.rows,
        vec![vec!["reporting".to_string(), "daily_metrics".to_string()]]
    );
    assert_eq!(pg_filtered_views.rows, fl_filtered_views.rows);

    let pg_in_order_tables = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        None,
        "SELECT schemaname, tablename FROM pg_catalog.pg_tables WHERE schemaname IN ('reporting', 'alpha') ORDER BY schemaname, tablename",
    );
    let fl_in_order_tables = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        None,
        "SELECT schemaname, tablename FROM pg_catalog.pg_tables WHERE schemaname IN ('reporting', 'alpha') ORDER BY schemaname, tablename",
    );
    assert_eq!(pg_in_order_tables.columns, vec!["schemaname", "tablename"]);
    assert_eq!(pg_in_order_tables.columns, fl_in_order_tables.columns);
    assert_eq!(
        pg_in_order_tables.rows,
        vec![
            vec!["alpha".to_string(), "fact_alpha".to_string()],
            vec!["reporting".to_string(), "dim_metrics".to_string()],
            vec!["reporting".to_string(), "fact_events".to_string()],
            vec!["reporting".to_string(), "fact_metrics".to_string()],
        ]
    );
    assert_eq!(pg_in_order_tables.rows, fl_in_order_tables.rows);

    let pg_in_order_views = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        None,
        "SELECT schemaname, viewname FROM pg_catalog.pg_views WHERE schemaname IN ('reporting', 'alpha') ORDER BY schemaname, viewname",
    );
    let fl_in_order_views = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        None,
        "SELECT schemaname, viewname FROM pg_catalog.pg_views WHERE schemaname IN ('reporting', 'alpha') ORDER BY schemaname, viewname",
    );
    assert_eq!(pg_in_order_views.columns, vec!["schemaname", "viewname"]);
    assert_eq!(pg_in_order_views.columns, fl_in_order_views.columns);
    assert_eq!(
        pg_in_order_views.rows,
        vec![
            vec!["alpha".to_string(), "daily_alpha".to_string()],
            vec!["reporting".to_string(), "daily_metrics".to_string()],
        ]
    );
    assert_eq!(pg_in_order_views.rows, fl_in_order_views.rows);

    let pg_desc_tables = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        None,
        "SELECT schemaname, tablename FROM pg_catalog.pg_tables WHERE schemaname IN ('reporting', 'alpha') ORDER BY schemaname DESC, tablename ASC",
    );
    let fl_desc_tables = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        None,
        "SELECT schemaname, tablename FROM pg_catalog.pg_tables WHERE schemaname IN ('reporting', 'alpha') ORDER BY schemaname DESC, tablename ASC",
    );
    assert_eq!(pg_desc_tables.columns, vec!["schemaname", "tablename"]);
    assert_eq!(pg_desc_tables.columns, fl_desc_tables.columns);
    assert_eq!(
        pg_desc_tables.rows,
        vec![
            vec!["reporting".to_string(), "dim_metrics".to_string()],
            vec!["reporting".to_string(), "fact_events".to_string()],
            vec!["reporting".to_string(), "fact_metrics".to_string()],
            vec!["alpha".to_string(), "fact_alpha".to_string()],
        ]
    );
    assert_eq!(pg_desc_tables.rows, fl_desc_tables.rows);

    let pg_desc_views = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        None,
        "SELECT schemaname, viewname FROM pg_catalog.pg_views WHERE schemaname IN ('reporting', 'alpha') ORDER BY schemaname DESC, viewname ASC",
    );
    let fl_desc_views = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        None,
        "SELECT schemaname, viewname FROM pg_catalog.pg_views WHERE schemaname IN ('reporting', 'alpha') ORDER BY schemaname DESC, viewname ASC",
    );
    assert_eq!(pg_desc_views.columns, vec!["schemaname", "viewname"]);
    assert_eq!(pg_desc_views.columns, fl_desc_views.columns);
    assert_eq!(
        pg_desc_views.rows,
        vec![
            vec!["reporting".to_string(), "daily_metrics".to_string()],
            vec!["alpha".to_string(), "daily_alpha".to_string()],
        ]
    );
    assert_eq!(pg_desc_views.rows, fl_desc_views.rows);

    let pg_desc_namespace = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        None,
        "SELECT nspname FROM pg_catalog.pg_namespace WHERE nspname IN ('reporting', 'public', 'alpha') ORDER BY nspname DESC",
    );
    let fl_desc_namespace = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        None,
        "SELECT nspname FROM pg_catalog.pg_namespace WHERE nspname IN ('reporting', 'public', 'alpha') ORDER BY nspname DESC",
    );
    assert_eq!(pg_desc_namespace.columns, vec!["nspname"]);
    assert_eq!(pg_desc_namespace.columns, fl_desc_namespace.columns);
    assert_eq!(
        pg_desc_namespace.rows,
        vec![
            vec!["reporting".to_string()],
            vec!["public".to_string()],
            vec!["alpha".to_string()],
        ]
    );
    assert_eq!(pg_desc_namespace.rows, fl_desc_namespace.rows);

    let pg_database = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        None,
        "SELECT datname FROM pg_catalog.pg_database ORDER BY datname",
    );
    let fl_database = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        None,
        "SELECT datname FROM pg_catalog.pg_database ORDER BY datname",
    );
    assert_eq!(pg_database.columns, vec!["datname"]);
    assert_eq!(pg_database.columns, fl_database.columns);
    assert_eq!(pg_database.rows, vec![vec!["postgres".to_string()]]);
    assert_eq!(pg_database.rows, fl_database.rows);

    let pg_roles = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        None,
        "SELECT rolname FROM pg_catalog.pg_roles WHERE rolname IN ('postgres', 'analyticsdb_admin') ORDER BY rolname",
    );
    let fl_roles = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        None,
        "SELECT rolname FROM pg_catalog.pg_roles WHERE rolname IN ('postgres', 'analyticsdb_admin') ORDER BY rolname",
    );
    assert_eq!(pg_roles.columns, vec!["rolname"]);
    assert_eq!(pg_roles.columns, fl_roles.columns);
    assert_eq!(
        pg_roles.rows,
        vec![
            vec!["analyticsdb_admin".to_string()],
            vec!["postgres".to_string()]
        ]
    );
    assert_eq!(pg_roles.rows, fl_roles.rows);

    cleanup_catalog_artifacts(&postgres_catalog_path);
    cleanup_catalog_artifacts(&flight_catalog_path);
}

#[tokio::test(flavor = "multi_thread")]
async fn cli_protocols_expose_information_schema_metadata_slice() {
    let postgres_catalog_path = temp_catalog_path();
    let flight_catalog_path = temp_catalog_path();
    let (_postgres_server, postgres_endpoint) = start_postgres_server(&postgres_catalog_path).await;
    let (_flight_server, flight_endpoint) = start_flight_sql_server(&flight_catalog_path).await;

    let _ = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        None,
        "CREATE SCHEMA reporting",
    );
    let _ = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        None,
        "CREATE SCHEMA reporting",
    );
    let _ = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        Some("reporting"),
        "CREATE TABLE fact_metrics (metric BIGINT NOT NULL, status TEXT)",
    );
    let _ = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        Some("reporting"),
        "CREATE TABLE fact_metrics (metric BIGINT NOT NULL, status TEXT)",
    );
    let _ = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        Some("reporting"),
        "CREATE VIEW daily_metrics AS SELECT metric, status FROM fact_metrics",
    );
    let _ = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        Some("reporting"),
        "CREATE VIEW daily_metrics AS SELECT metric, status FROM fact_metrics",
    );
    let _ = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        Some("reporting"),
        "CREATE TABLE dim_metrics (metric BIGINT NOT NULL, label TEXT, CONSTRAINT dim_metrics_pkey PRIMARY KEY (metric))",
    );
    let _ = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        Some("reporting"),
        "CREATE TABLE dim_metrics (metric BIGINT NOT NULL, label TEXT, CONSTRAINT dim_metrics_pkey PRIMARY KEY (metric))",
    );
    let _ = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        Some("reporting"),
        "CREATE TABLE fact_events (metric_id BIGINT NOT NULL, CONSTRAINT fact_events_metric_fk FOREIGN KEY (metric_id) REFERENCES reporting.dim_metrics(metric))",
    );
    let _ = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        Some("reporting"),
        "CREATE TABLE fact_events (metric_id BIGINT NOT NULL, CONSTRAINT fact_events_metric_fk FOREIGN KEY (metric_id) REFERENCES reporting.dim_metrics(metric))",
    );

    let pg_schemata = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        None,
        "SELECT schema_name FROM information_schema.schemata ORDER BY schema_name",
    );
    let fl_schemata = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        None,
        "SELECT schema_name FROM information_schema.schemata ORDER BY schema_name",
    );
    assert_eq!(pg_schemata.columns, vec!["schema_name"]);
    assert_eq!(pg_schemata.columns, fl_schemata.columns);
    assert_eq!(pg_schemata.rows, fl_schemata.rows);

    let pg_tables = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        None,
        "SELECT table_schema, table_name, table_type FROM information_schema.tables WHERE table_schema = 'reporting' ORDER BY table_name",
    );
    let fl_tables = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        None,
        "SELECT table_schema, table_name, table_type FROM information_schema.tables WHERE table_schema = 'reporting' ORDER BY table_name",
    );
    assert_eq!(
        pg_tables.rows,
        vec![
            vec![
                "reporting".to_string(),
                "daily_metrics".to_string(),
                "VIEW".to_string()
            ],
            vec![
                "reporting".to_string(),
                "dim_metrics".to_string(),
                "BASE TABLE".to_string()
            ],
            vec![
                "reporting".to_string(),
                "fact_events".to_string(),
                "BASE TABLE".to_string()
            ],
            vec![
                "reporting".to_string(),
                "fact_metrics".to_string(),
                "BASE TABLE".to_string()
            ],
        ]
    );
    assert_eq!(pg_tables.rows, fl_tables.rows);

    let pg_columns = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        None,
        "SELECT table_schema, table_name, column_name, ordinal_position, is_nullable, data_type FROM information_schema.columns WHERE table_name = 'fact_metrics' ORDER BY ordinal_position",
    );
    let fl_columns = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        None,
        "SELECT table_schema, table_name, column_name, ordinal_position, is_nullable, data_type FROM information_schema.columns WHERE table_name = 'fact_metrics' ORDER BY ordinal_position",
    );
    assert_eq!(
        pg_columns.rows,
        vec![
            vec![
                "reporting".to_string(),
                "fact_metrics".to_string(),
                "metric".to_string(),
                "1".to_string(),
                "NO".to_string(),
                "int64".to_string()
            ],
            vec![
                "reporting".to_string(),
                "fact_metrics".to_string(),
                "status".to_string(),
                "2".to_string(),
                "YES".to_string(),
                "utf8".to_string()
            ],
        ]
    );
    assert_eq!(pg_columns.rows, fl_columns.rows);

    let pg_views = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        None,
        "SELECT table_schema, table_name, is_updatable FROM information_schema.views WHERE table_schema = 'reporting' ORDER BY table_name",
    );
    let fl_views = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        None,
        "SELECT table_schema, table_name, is_updatable FROM information_schema.views WHERE table_schema = 'reporting' ORDER BY table_name",
    );
    assert_eq!(
        pg_views.rows,
        vec![vec![
            "reporting".to_string(),
            "daily_metrics".to_string(),
            "NO".to_string()
        ]]
    );
    assert_eq!(pg_views.rows, fl_views.rows);

    let pg_constraints = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        None,
        "SELECT table_schema, table_name, constraint_name, constraint_type FROM information_schema.table_constraints WHERE constraint_name = 'fact_metrics_metric_not_null'",
    );
    let fl_constraints = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        None,
        "SELECT table_schema, table_name, constraint_name, constraint_type FROM information_schema.table_constraints WHERE constraint_name = 'fact_metrics_metric_not_null'",
    );
    assert_eq!(
        pg_constraints.rows,
        vec![vec![
            "reporting".to_string(),
            "fact_metrics".to_string(),
            "fact_metrics_metric_not_null".to_string(),
            "CHECK".to_string()
        ]]
    );
    assert_eq!(pg_constraints.rows, fl_constraints.rows);

    let pg_key_usage = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        None,
        "SELECT table_name, column_name, constraint_name FROM information_schema.key_column_usage WHERE table_name IN ('dim_metrics', 'fact_events') ORDER BY table_name, constraint_name",
    );
    let fl_key_usage = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        None,
        "SELECT table_name, column_name, constraint_name FROM information_schema.key_column_usage WHERE table_name IN ('dim_metrics', 'fact_events') ORDER BY table_name, constraint_name",
    );
    assert_eq!(
        pg_key_usage.rows,
        vec![
            vec![
                "dim_metrics".to_string(),
                "metric".to_string(),
                "dim_metrics_pkey".to_string(),
            ],
            vec![
                "fact_events".to_string(),
                "metric_id".to_string(),
                "fact_events_metric_fk".to_string(),
            ],
        ]
    );
    assert_eq!(pg_key_usage.rows, fl_key_usage.rows);

    let pg_constraint_column_usage = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        None,
        "SELECT table_schema, table_name, column_name, constraint_name FROM information_schema.constraint_column_usage WHERE constraint_name = 'fact_metrics_metric_not_null'",
    );
    let fl_constraint_column_usage = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        None,
        "SELECT table_schema, table_name, column_name, constraint_name FROM information_schema.constraint_column_usage WHERE constraint_name = 'fact_metrics_metric_not_null'",
    );
    assert_eq!(
        pg_constraint_column_usage.rows,
        vec![vec![
            "reporting".to_string(),
            "fact_metrics".to_string(),
            "metric".to_string(),
            "fact_metrics_metric_not_null".to_string(),
        ]]
    );
    assert_eq!(
        pg_constraint_column_usage.rows,
        fl_constraint_column_usage.rows
    );

    let pg_constraint_table_usage = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        None,
        "SELECT table_schema, table_name, constraint_name FROM information_schema.constraint_table_usage WHERE constraint_name = 'fact_metrics_metric_not_null'",
    );
    let fl_constraint_table_usage = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        None,
        "SELECT table_schema, table_name, constraint_name FROM information_schema.constraint_table_usage WHERE constraint_name = 'fact_metrics_metric_not_null'",
    );
    assert_eq!(
        pg_constraint_table_usage.rows,
        vec![vec![
            "reporting".to_string(),
            "fact_metrics".to_string(),
            "fact_metrics_metric_not_null".to_string(),
        ]]
    );
    assert_eq!(
        pg_constraint_table_usage.rows,
        fl_constraint_table_usage.rows
    );

    let pg_referential_constraints = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        None,
        "SELECT constraint_name, unique_constraint_name, update_rule, delete_rule FROM information_schema.referential_constraints ORDER BY constraint_name",
    );
    let fl_referential_constraints = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        None,
        "SELECT constraint_name, unique_constraint_name, update_rule, delete_rule FROM information_schema.referential_constraints ORDER BY constraint_name",
    );
    assert_eq!(
        pg_referential_constraints.rows,
        vec![vec![
            "fact_events_metric_fk".to_string(),
            "dim_metrics_pkey".to_string(),
            "NO ACTION".to_string(),
            "NO ACTION".to_string(),
        ]]
    );
    assert_eq!(
        pg_referential_constraints.rows,
        fl_referential_constraints.rows
    );

    cleanup_catalog_artifacts(&postgres_catalog_path);
    cleanup_catalog_artifacts(&flight_catalog_path);
}

#[tokio::test(flavor = "multi_thread")]
async fn cli_protocols_cover_supported_sql_surface_with_matrix_parity() {
    struct SuccessCase {
        name: &'static str,
        capability: SqlCapability,
        database: Option<&'static str>,
        schema: Option<&'static str>,
        sql: &'static str,
    }

    struct ErrorCase {
        name: &'static str,
        database: Option<&'static str>,
        schema: Option<&'static str>,
        sql: &'static str,
        expected_substring: &'static str,
    }

    enum CommandErrorExpectation {
        Exact(&'static str),
        Substring(&'static str),
        AnyKeyword(&'static [&'static str]),
    }

    struct CommandErrorCase {
        name: &'static str,
        database: Option<&'static str>,
        schema: Option<&'static str>,
        user: &'static str,
        role: Option<&'static str>,
        password: Option<&'static str>,
        sql: &'static str,
        expectation: CommandErrorExpectation,
    }

    let postgres_catalog_path = temp_catalog_path();
    let flight_catalog_path = temp_catalog_path();
    let (_postgres_server, postgres_endpoint) = start_postgres_server(&postgres_catalog_path).await;
    let (_flight_server, flight_endpoint) = start_flight_sql_server(&flight_catalog_path).await;

    let setup_cases = [
        SuccessCase {
            name: "create analytics database",
            capability: SqlCapability::CreateDatabase,
            database: None,
            schema: None,
            sql: "CREATE DATABASE analytics",
        },
        SuccessCase {
            name: "show databases",
            capability: SqlCapability::ShowDatabases,
            database: None,
            schema: None,
            sql: "SHOW DATABASES",
        },
        SuccessCase {
            name: "show schemas",
            capability: SqlCapability::ShowSchemas,
            database: None,
            schema: None,
            sql: "SHOW SCHEMAS",
        },
        SuccessCase {
            name: "create reporting schema in postgres",
            capability: SqlCapability::CreateSchema,
            database: None,
            schema: None,
            sql: "CREATE SCHEMA reporting",
        },
        SuccessCase {
            name: "create qualified schema in analytics",
            capability: SqlCapability::CreateSchemaQualified,
            database: None,
            schema: None,
            sql: "CREATE SCHEMA analytics.reporting",
        },
        SuccessCase {
            name: "show schemas from analytics",
            capability: SqlCapability::ShowSchemasFromDatabase,
            database: None,
            schema: None,
            sql: "SHOW SCHEMAS FROM analytics",
        },
        SuccessCase {
            name: "show nodes",
            capability: SqlCapability::ShowNodes,
            database: None,
            schema: None,
            sql: "SHOW NODES",
        },
        SuccessCase {
            name: "create ctas table",
            capability: SqlCapability::CreateTableAs,
            database: None,
            schema: None,
            sql: "CREATE TABLE fact_ctas AS SELECT 11 AS metric, 'ok' AS status",
        },
        SuccessCase {
            name: "create schema-qualified ctas table",
            capability: SqlCapability::CreateTableQualifiedAs,
            database: None,
            schema: None,
            sql: "CREATE TABLE reporting.fact_ctas_reporting AS SELECT 31 AS metric, 'schema' AS status",
        },
        SuccessCase {
            name: "show tables default schema",
            capability: SqlCapability::ShowTables,
            database: None,
            schema: None,
            sql: "SHOW TABLES",
        },
        SuccessCase {
            name: "show tables from schema",
            capability: SqlCapability::ShowTablesFromSchema,
            database: None,
            schema: None,
            sql: "SHOW TABLES FROM reporting",
        },
        SuccessCase {
            name: "create view from ctas",
            capability: SqlCapability::CreateView,
            database: None,
            schema: None,
            sql: "CREATE VIEW daily_metrics AS SELECT metric, status FROM fact_ctas",
        },
        SuccessCase {
            name: "create schema-qualified view",
            capability: SqlCapability::CreateViewQualified,
            database: None,
            schema: None,
            sql: "CREATE VIEW reporting.daily_metrics_reporting AS SELECT metric, status FROM reporting.fact_ctas_reporting",
        },
        SuccessCase {
            name: "show views default schema",
            capability: SqlCapability::ShowViews,
            database: None,
            schema: None,
            sql: "SHOW VIEWS",
        },
        SuccessCase {
            name: "show views from schema",
            capability: SqlCapability::ShowViewsFromSchema,
            database: None,
            schema: None,
            sql: "SHOW VIEWS FROM reporting",
        },
        SuccessCase {
            name: "show columns from ctas table",
            capability: SqlCapability::ShowColumns,
            database: None,
            schema: None,
            sql: "SHOW COLUMNS FROM fact_ctas",
        },
        SuccessCase {
            name: "describe ctas table",
            capability: SqlCapability::Describe,
            database: None,
            schema: None,
            sql: "DESCRIBE fact_ctas",
        },
        SuccessCase {
            name: "explain query",
            capability: SqlCapability::Explain,
            database: None,
            schema: None,
            sql: "EXPLAIN SELECT 1",
        },
        SuccessCase {
            name: "query persisted view",
            capability: SqlCapability::Describe,
            database: None,
            schema: None,
            sql: "SELECT metric, status FROM daily_metrics",
        },
        SuccessCase {
            name: "alter user password",
            capability: SqlCapability::AlterUserPassword,
            database: None,
            schema: None,
            sql: "ALTER USER analytics_reader PASSWORD 'matrix-rotated'",
        },
        SuccessCase {
            name: "create typed table for error checks",
            capability: SqlCapability::CreateTableDefined,
            database: None,
            schema: None,
            sql: "CREATE TABLE fact_errors (metric BIGINT NOT NULL, status TEXT)",
        },
        SuccessCase {
            name: "insert full row into typed table",
            capability: SqlCapability::InsertValues,
            database: None,
            schema: None,
            sql: "INSERT INTO fact_errors VALUES (11, 'ok')",
        },
        SuccessCase {
            name: "insert column list into typed table",
            capability: SqlCapability::InsertValuesColumnList,
            database: None,
            schema: None,
            sql: "INSERT INTO fact_errors (metric, status) VALUES (12, 'warn')",
        },
        SuccessCase {
            name: "query typed table",
            capability: SqlCapability::InsertValues,
            database: None,
            schema: None,
            sql: "SELECT metric, status FROM fact_errors ORDER BY metric",
        },
        SuccessCase {
            name: "delete from typed table",
            capability: SqlCapability::Delete,
            database: None,
            schema: None,
            sql: "DELETE FROM fact_errors WHERE metric = 11",
        },
        SuccessCase {
            name: "truncate typed table",
            capability: SqlCapability::Truncate,
            database: None,
            schema: None,
            sql: "TRUNCATE TABLE fact_errors",
        },
        SuccessCase {
            name: "re-insert into typed table after truncate",
            capability: SqlCapability::InsertValues,
            database: None,
            schema: None,
            sql: "INSERT INTO fact_errors VALUES (11, 'ok')",
        },
        SuccessCase {
            name: "create cross-database qualified table",
            capability: SqlCapability::CreateTableQualifiedDefined,
            database: Some("analytics"),
            schema: None,
            sql: "CREATE TABLE reporting.fact_cross (metric BIGINT NOT NULL, status TEXT)",
        },
        SuccessCase {
            name: "insert into cross-database qualified table",
            capability: SqlCapability::InsertValuesColumnList,
            database: Some("analytics"),
            schema: None,
            sql: "INSERT INTO reporting.fact_cross (metric, status) VALUES (21, 'x')",
        },
        SuccessCase {
            name: "create cross-database qualified view",
            capability: SqlCapability::CreateViewQualified,
            database: Some("analytics"),
            schema: None,
            sql: "CREATE VIEW reporting.daily_metrics_cross AS SELECT metric, status FROM reporting.fact_cross",
        },
        SuccessCase {
            name: "show tables from cross-database schema",
            capability: SqlCapability::ShowTablesFromDatabaseSchema,
            database: None,
            schema: None,
            sql: "SHOW TABLES FROM analytics.reporting",
        },
        SuccessCase {
            name: "show views from cross-database schema",
            capability: SqlCapability::ShowViewsFromDatabaseSchema,
            database: None,
            schema: None,
            sql: "SHOW VIEWS FROM analytics.reporting",
        },
    ];

    let drop_cases = [
        SuccessCase {
            name: "update typed table",
            capability: SqlCapability::Update,
            database: None,
            schema: None,
            sql: "UPDATE fact_errors SET status = 'updated' WHERE metric = 11",
        },
        SuccessCase {
            name: "alter table add column",
            capability: SqlCapability::AlterTable,
            database: None,
            schema: None,
            sql: "ALTER TABLE fact_errors ADD COLUMN is_active BOOLEAN DEFAULT true",
        },
        SuccessCase {
            name: "query table after alter",
            capability: SqlCapability::Update,
            database: None,
            schema: None,
            sql: "SELECT metric, status, CASE WHEN is_active THEN 'true' ELSE 'false' END AS is_active FROM fact_errors WHERE metric = 11",
        },
        SuccessCase {
            name: "update new column",
            capability: SqlCapability::Update,
            database: None,
            schema: None,
            sql: "UPDATE fact_errors SET is_active = false WHERE metric = 11",
        },
        SuccessCase {
            name: "query table after update boolean",
            capability: SqlCapability::Update,
            database: None,
            schema: None,
            sql: "SELECT metric, status, CASE WHEN is_active THEN 'true' ELSE 'false' END AS is_active FROM fact_errors WHERE metric = 11",
        },
        SuccessCase {
            name: "rename table",
            capability: SqlCapability::AlterTable,
            database: None,
            schema: None,
            sql: "ALTER TABLE fact_errors RENAME TO fact_errors_renamed",
        },
        SuccessCase {
            name: "query renamed table",
            capability: SqlCapability::Update,
            database: None,
            schema: None,
            sql: "SELECT metric, status, CASE WHEN is_active THEN 'true' ELSE 'false' END AS is_active FROM fact_errors_renamed WHERE metric = 11",
        },
        SuccessCase {
            name: "create schema to rename",
            capability: SqlCapability::CreateSchema,
            database: None,
            schema: None,
            sql: "CREATE SCHEMA to_be_renamed",
        },
        SuccessCase {
            name: "rename schema",
            capability: SqlCapability::AlterSchema,
            database: None,
            schema: None,
            sql: "ALTER SCHEMA to_be_renamed RENAME TO renamed_schema",
        },
        SuccessCase {
            name: "show tables in renamed schema",
            capability: SqlCapability::ShowTablesFromSchema,
            database: None,
            schema: None,
            sql: "SHOW TABLES FROM renamed_schema",
        },
        SuccessCase {
            name: "drop renamed schema",
            capability: SqlCapability::DropSchema,
            database: None,
            schema: None,
            sql: "DROP SCHEMA renamed_schema",
        },
        SuccessCase {
            name: "drop qualified view",
            capability: SqlCapability::DropView,
            database: None,
            schema: None,
            sql: "DROP VIEW reporting.daily_metrics_reporting",
        },
        SuccessCase {
            name: "drop view",
            capability: SqlCapability::DropView,
            database: None,
            schema: None,
            sql: "DROP VIEW daily_metrics",
        },
        SuccessCase {
            name: "drop qualified table",
            capability: SqlCapability::DropTable,
            database: None,
            schema: None,
            sql: "DROP TABLE reporting.fact_ctas_reporting",
        },
        SuccessCase {
            name: "drop table",
            capability: SqlCapability::DropTable,
            database: None,
            schema: None,
            sql: "DROP TABLE fact_ctas",
        },
        SuccessCase {
            name: "drop qualified schema",
            capability: SqlCapability::DropSchema,
            database: None,
            schema: None,
            sql: "DROP SCHEMA analytics.reporting CASCADE",
        },
        SuccessCase {
            name: "drop schema",
            capability: SqlCapability::DropSchema,
            database: None,
            schema: None,
            sql: "DROP SCHEMA reporting CASCADE",
        },
        SuccessCase {
            name: "drop database",
            capability: SqlCapability::DropDatabase,
            database: None,
            schema: None,
            sql: "DROP DATABASE analytics",
        },
    ];

    let covered_capabilities = setup_cases
        .iter()
        .chain(drop_cases.iter())
        .map(|case| case.capability)
        .collect::<BTreeSet<_>>();
    assert_eq!(
        covered_capabilities,
        parity_matrix_sql_capabilities(),
        "matrix cases and declared parity matrix capabilities diverged"
    );
    assert_eq!(
        covered_capabilities,
        documented_sql_capabilities_from_readme(),
        "matrix cases and README supported SQL subset diverged"
    );

    for case in setup_cases {
        let postgres = protocol_json_response_with_context(
            "postgres",
            &postgres_endpoint,
            case.database,
            case.schema,
            case.sql,
        );
        let flight_sql = protocol_json_response_with_context(
            "flight-sql",
            &flight_endpoint,
            case.database,
            case.schema,
            case.sql,
        );
        assert_supported_protocol_equivalence(case.name, &postgres, &flight_sql);
    }

    let query_error_cases = [
        ErrorCase {
            name: "unknown database query error",
            database: Some("missing"),
            schema: None,
            sql: "SELECT 1 AS one",
            expected_substring: "Unknown database 'missing'",
        },
        ErrorCase {
            name: "unknown schema query error",
            database: None,
            schema: Some("missing_schema"),
            sql: "SELECT 1 AS one",
            expected_substring: "Unknown schema 'postgres.missing_schema'",
        },
        ErrorCase {
            name: "missing relation query error",
            database: None,
            schema: Some("reporting"),
            sql: "SELECT * FROM missing_table",
            expected_substring: "not found",
        },
    ];

    for case in query_error_cases {
        let postgres = protocol_stderr_failure(
            "postgres",
            &postgres_endpoint,
            case.database,
            case.schema,
            case.sql,
        );
        let flight_sql = protocol_stderr_failure(
            "flight-sql",
            &flight_endpoint,
            case.database,
            case.schema,
            case.sql,
        );
        assert_supported_protocol_error_equivalence(
            case.name,
            &postgres,
            &flight_sql,
            case.expected_substring,
        );
    }

    let command_error_cases = [
        CommandErrorCase {
            name: "duplicate create table command error",
            database: None,
            schema: None,
            user: "postgres",
            role: Some("postgres"),
            password: Some("postgres"),
            sql: "CREATE TABLE fact_errors (metric BIGINT NOT NULL, status TEXT)",
            expectation: CommandErrorExpectation::Exact(
                "Relation 'postgres.public.fact_errors' already exists",
            ),
        },
        CommandErrorCase {
            name: "not-null insert command error",
            database: None,
            schema: None,
            user: "postgres",
            role: Some("postgres"),
            password: Some("postgres"),
            sql: "INSERT INTO fact_errors (status) VALUES ('ok')",
            expectation: CommandErrorExpectation::Exact(
                "Column 'metric' must be provided because it is NOT NULL",
            ),
        },
        CommandErrorCase {
            name: "insert value count command error",
            database: None,
            schema: None,
            user: "postgres",
            role: Some("postgres"),
            password: Some("postgres"),
            sql: "INSERT INTO fact_errors VALUES (13)",
            expectation: CommandErrorExpectation::Exact("Expected 2 value(s) per row, found 1"),
        },
        CommandErrorCase {
            name: "alter user unknown user command error",
            database: None,
            schema: Some("public"),
            user: "postgres",
            role: Some("postgres"),
            password: Some("postgres"),
            sql: "ALTER USER missing_user PASSWORD 'next'",
            expectation: CommandErrorExpectation::Exact("Unknown user 'missing_user'"),
        },
        CommandErrorCase {
            name: "alter user empty password command error",
            database: None,
            schema: Some("public"),
            user: "postgres",
            role: Some("postgres"),
            password: Some("postgres"),
            sql: "ALTER USER analytics_reader PASSWORD ''",
            expectation: CommandErrorExpectation::Exact("Password must not be empty"),
        },
        CommandErrorCase {
            name: "alter user malformed literal command error",
            database: None,
            schema: Some("public"),
            user: "postgres",
            role: Some("postgres"),
            password: Some("postgres"),
            sql: "ALTER USER analytics_reader PASSWORD reader_next",
            expectation: CommandErrorExpectation::AnyKeyword(&[
                "SQL", "Parser", "syntax", "ALTER", "PASSWORD",
            ]),
        },
        CommandErrorCase {
            name: "alter user non-admin command error",
            database: None,
            schema: Some("public"),
            user: "analytics_reader",
            role: Some("analytics_reader"),
            password: Some("matrix-rotated"),
            sql: "ALTER USER postgres PASSWORD 'next'",
            expectation: CommandErrorExpectation::Exact("not allowed to rotate credentials"),
        },
        CommandErrorCase {
            name: "rename missing table error",
            database: None,
            schema: None,
            user: "postgres",
            role: Some("postgres"),
            password: Some("postgres"),
            sql: "ALTER TABLE missing_table RENAME TO new_name",
            expectation: CommandErrorExpectation::Substring("not found"),
        },
        CommandErrorCase {
            name: "rename table to existing error",
            database: None,
            schema: None,
            user: "postgres",
            role: Some("postgres"),
            password: Some("postgres"),
            sql: "ALTER TABLE fact_ctas RENAME TO fact_ctas",
            expectation: CommandErrorExpectation::Substring("already exists"),
        },
        CommandErrorCase {
            name: "rename missing schema error",
            database: None,
            schema: None,
            user: "postgres",
            role: Some("postgres"),
            password: Some("postgres"),
            sql: "ALTER SCHEMA missing_schema RENAME TO new_name",
            expectation: CommandErrorExpectation::Substring("not found"),
        },
    ];

    for case in command_error_cases {
        let postgres = protocol_stderr_failure_with_auth_context(
            "postgres",
            &postgres_endpoint,
            case.database,
            case.schema,
            case.user,
            case.role,
            case.password,
            case.sql,
        );
        let flight_sql = protocol_stderr_failure_with_auth_context(
            "flight-sql",
            &flight_endpoint,
            case.database,
            case.schema,
            case.user,
            case.role,
            case.password,
            case.sql,
        );
        match case.expectation {
            CommandErrorExpectation::Exact(expected_substring) => {
                assert_supported_protocol_command_error_equivalence(
                    case.name,
                    &postgres,
                    &flight_sql,
                    expected_substring,
                );
            }
            CommandErrorExpectation::Substring(expected_substring) => {
                assert_supported_protocol_command_error_equivalence(
                    case.name,
                    &postgres,
                    &flight_sql,
                    expected_substring,
                );
            }
            CommandErrorExpectation::AnyKeyword(keywords) => {
                assert_supported_protocol_command_error_contains_any(
                    case.name,
                    &postgres,
                    &flight_sql,
                    keywords,
                );
            }
        }
    }

    for case in drop_cases {
        let postgres = protocol_json_response_with_context(
            "postgres",
            &postgres_endpoint,
            case.database,
            case.schema,
            case.sql,
        );
        let flight_sql = protocol_json_response_with_context(
            "flight-sql",
            &flight_endpoint,
            case.database,
            case.schema,
            case.sql,
        );
        assert_supported_protocol_equivalence(case.name, &postgres, &flight_sql);
    }

    cleanup_catalog_artifacts(&postgres_catalog_path);
    cleanup_catalog_artifacts(&flight_catalog_path);
}

// ---------------------------------------------------------------------------
// Result-shape assertions for metadata SQL through the wire protocols
// ---------------------------------------------------------------------------

#[tokio::test(flavor = "multi_thread")]
async fn cli_wire_protocols_return_exact_result_shape_for_metadata_sql() {
    let catalog_path = temp_catalog_path();
    let (_postgres_server, postgres_endpoint) = start_postgres_server(&catalog_path).await;
    let (_flight_server, flight_endpoint) = start_flight_sql_server(&catalog_path).await;

    // Establish a table and a view so SHOW TABLES / SHOW VIEWS return rows.
    let _create_table = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        Some("public"),
        "CREATE TABLE shape_tbl (id BIGINT NOT NULL, lbl TEXT, flag BOOLEAN)",
    );
    let _create_view = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        Some("public"),
        "CREATE VIEW shape_view AS SELECT id, lbl FROM shape_tbl",
    );
    // Mirror on flight-sql catalog (separate catalog per server in this test).
    let _ft = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        Some("public"),
        "CREATE TABLE shape_tbl (id BIGINT NOT NULL, lbl TEXT, flag BOOLEAN)",
    );
    let _fv = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        Some("public"),
        "CREATE VIEW shape_view AS SELECT id, lbl FROM shape_tbl",
    );

    // ---- SHOW DATABASES ----
    let pg_show_dbs =
        protocol_json_response("postgres", &postgres_endpoint, None, "SHOW DATABASES");
    let fl_show_dbs =
        protocol_json_response("flight-sql", &flight_endpoint, None, "SHOW DATABASES");
    assert_eq!(
        pg_show_dbs.columns,
        vec!["database_name".to_string()],
        "SHOW DATABASES postgres: unexpected columns"
    );
    assert_eq!(
        fl_show_dbs.columns,
        vec!["database_name".to_string()],
        "SHOW DATABASES flight-sql: unexpected columns"
    );
    // The default 'postgres' database must always appear.
    let pg_db_names: Vec<&str> = pg_show_dbs
        .rows
        .iter()
        .filter_map(|r| r.first().map(|s| s.as_str()))
        .collect();
    assert!(
        pg_db_names.contains(&"postgres"),
        "SHOW DATABASES should include 'postgres'; got {pg_db_names:?}"
    );

    // ---- SHOW SCHEMAS ----
    let pg_show_schemas =
        protocol_json_response("postgres", &postgres_endpoint, None, "SHOW SCHEMAS");
    let fl_show_schemas =
        protocol_json_response("flight-sql", &flight_endpoint, None, "SHOW SCHEMAS");
    assert_eq!(
        pg_show_schemas.columns,
        vec!["schema_name".to_string()],
        "SHOW SCHEMAS postgres: unexpected columns"
    );
    assert_eq!(
        fl_show_schemas.columns,
        vec!["schema_name".to_string()],
        "SHOW SCHEMAS flight-sql: unexpected columns"
    );
    let pg_schema_names: Vec<&str> = pg_show_schemas
        .rows
        .iter()
        .filter_map(|r| r.first().map(|s| s.as_str()))
        .collect();
    assert!(
        pg_schema_names.contains(&"public"),
        "SHOW SCHEMAS should include 'public'; got {pg_schema_names:?}"
    );

    // ---- SHOW TABLES ----
    let pg_show_tables = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        Some("public"),
        "SHOW TABLES",
    );
    let fl_show_tables = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        Some("public"),
        "SHOW TABLES",
    );
    assert_eq!(
        pg_show_tables.columns,
        vec!["table_name".to_string()],
        "SHOW TABLES postgres: unexpected columns"
    );
    assert_eq!(
        fl_show_tables.columns,
        vec!["table_name".to_string()],
        "SHOW TABLES flight-sql: unexpected columns"
    );
    let pg_table_names: Vec<&str> = pg_show_tables
        .rows
        .iter()
        .filter_map(|r| r.first().map(|s| s.as_str()))
        .collect();
    assert!(
        pg_table_names.contains(&"shape_tbl"),
        "SHOW TABLES should include 'shape_tbl'; got {pg_table_names:?}"
    );

    // ---- SHOW TABLES FROM <schema> ----
    let pg_show_tables_from = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        None,
        "SHOW TABLES FROM public",
    );
    let fl_show_tables_from = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        None,
        "SHOW TABLES FROM public",
    );
    assert_eq!(
        pg_show_tables_from.columns,
        vec!["table_name".to_string()],
        "SHOW TABLES FROM schema postgres: unexpected columns"
    );
    assert_eq!(
        fl_show_tables_from.columns,
        vec!["table_name".to_string()],
        "SHOW TABLES FROM schema flight-sql: unexpected columns"
    );

    // ---- SHOW VIEWS ----
    let pg_show_views =
        protocol_json_response("postgres", &postgres_endpoint, Some("public"), "SHOW VIEWS");
    let fl_show_views =
        protocol_json_response("flight-sql", &flight_endpoint, Some("public"), "SHOW VIEWS");
    assert_eq!(
        pg_show_views.columns,
        vec!["view_name".to_string()],
        "SHOW VIEWS postgres: unexpected columns"
    );
    assert_eq!(
        fl_show_views.columns,
        vec!["view_name".to_string()],
        "SHOW VIEWS flight-sql: unexpected columns"
    );
    let pg_view_names: Vec<&str> = pg_show_views
        .rows
        .iter()
        .filter_map(|r| r.first().map(|s| s.as_str()))
        .collect();
    assert!(
        pg_view_names.contains(&"shape_view"),
        "SHOW VIEWS should include 'shape_view'; got {pg_view_names:?}"
    );

    // ---- SHOW COLUMNS FROM <table> ----
    let expected_col_columns = vec![
        "column_name".to_string(),
        "data_type".to_string(),
        "is_nullable".to_string(),
    ];
    let pg_show_cols = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        Some("public"),
        "SHOW COLUMNS FROM shape_tbl",
    );
    let fl_show_cols = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        Some("public"),
        "SHOW COLUMNS FROM shape_tbl",
    );
    assert_eq!(
        pg_show_cols.columns, expected_col_columns,
        "SHOW COLUMNS postgres: unexpected columns"
    );
    assert_eq!(
        fl_show_cols.columns, expected_col_columns,
        "SHOW COLUMNS flight-sql: unexpected columns"
    );
    // Three columns defined → three rows from SHOW COLUMNS.
    assert_eq!(
        pg_show_cols.rows.len(),
        3,
        "SHOW COLUMNS should return one row per column; postgres got {:?}",
        pg_show_cols.rows
    );
    assert_eq!(
        fl_show_cols.rows.len(),
        3,
        "SHOW COLUMNS should return one row per column; flight-sql got {:?}",
        fl_show_cols.rows
    );
    // Verify column names appear in the rows.
    let pg_col_names: Vec<&str> = pg_show_cols
        .rows
        .iter()
        .filter_map(|r| r.first().map(|s| s.as_str()))
        .collect();
    assert!(
        pg_col_names.contains(&"id")
            && pg_col_names.contains(&"lbl")
            && pg_col_names.contains(&"flag"),
        "SHOW COLUMNS rows should list column names; got {pg_col_names:?}"
    );

    // ---- DESCRIBE <table> ----
    let pg_describe = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        Some("public"),
        "DESCRIBE shape_tbl",
    );
    let fl_describe = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        Some("public"),
        "DESCRIBE shape_tbl",
    );
    assert_eq!(
        pg_describe.columns, expected_col_columns,
        "DESCRIBE postgres: unexpected columns"
    );
    assert_eq!(
        fl_describe.columns, expected_col_columns,
        "DESCRIBE flight-sql: unexpected columns"
    );
    assert_eq!(
        pg_describe.rows.len(),
        3,
        "DESCRIBE should return one row per column; postgres got {:?}",
        pg_describe.rows
    );

    // ---- SELECT scalar ----
    let pg_scalar = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        None,
        "SELECT 1 AS one, 2 AS two",
    );
    let fl_scalar = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        None,
        "SELECT 1 AS one, 2 AS two",
    );
    assert_eq!(
        pg_scalar.columns,
        vec!["one".to_string(), "two".to_string()],
        "SELECT scalar postgres: unexpected columns"
    );
    assert_eq!(
        fl_scalar.columns,
        vec!["one".to_string(), "two".to_string()],
        "SELECT scalar flight-sql: unexpected columns"
    );
    assert_eq!(
        pg_scalar.rows,
        vec![vec!["1".to_string(), "2".to_string()]],
        "SELECT scalar postgres: unexpected rows"
    );
    assert_eq!(
        fl_scalar.rows,
        vec![vec!["1".to_string(), "2".to_string()]],
        "SELECT scalar flight-sql: unexpected rows"
    );

    // ---- Cross-protocol column equivalence for all metadata shapes ----
    assert_eq!(
        pg_show_dbs.columns, fl_show_dbs.columns,
        "SHOW DATABASES column shape diverged across protocols"
    );
    assert_eq!(
        pg_show_schemas.columns, fl_show_schemas.columns,
        "SHOW SCHEMAS column shape diverged across protocols"
    );
    assert_eq!(
        pg_show_tables.columns, fl_show_tables.columns,
        "SHOW TABLES column shape diverged across protocols"
    );
    assert_eq!(
        pg_show_views.columns, fl_show_views.columns,
        "SHOW VIEWS column shape diverged across protocols"
    );
    assert_eq!(
        pg_show_cols.columns, fl_show_cols.columns,
        "SHOW COLUMNS column shape diverged across protocols"
    );
    assert_eq!(
        pg_describe.columns, fl_describe.columns,
        "DESCRIBE column shape diverged across protocols"
    );
    assert_eq!(
        pg_scalar.columns, fl_scalar.columns,
        "SELECT scalar column shape diverged across protocols"
    );

    cleanup_catalog_artifacts(&catalog_path);
}

#[tokio::test(flavor = "multi_thread")]
async fn cli_wire_protocols_keep_customers_sql_shapes_in_parity() {
    let catalog_path = temp_catalog_path();
    let (_postgres_server, postgres_endpoint) = start_postgres_server(&catalog_path).await;
    let (_flight_server, flight_endpoint) = start_flight_sql_server(&catalog_path).await;

    let setup = [
        "CREATE TABLE customers (id BIGINT NOT NULL, first_name TEXT, last_name TEXT, email TEXT, created_at TIMESTAMP)",
        "INSERT INTO customers VALUES (1, 'Ada', 'Lovelace', 'ada@example.com', TIMESTAMP '2024-01-01 00:00:00')",
        "INSERT INTO customers VALUES (2, 'Grace', 'Hopper', 'grace@example.com', TIMESTAMP '2024-01-02 00:00:00')",
    ];

    for sql in setup {
        let _ = protocol_json_response("postgres", &postgres_endpoint, Some("public"), sql);
        let _ = protocol_json_response("flight-sql", &flight_endpoint, Some("public"), sql);
    }

    let parity_cases = [
        ("select customers", "SELECT * FROM customers ORDER BY id"),
        ("describe customers", "DESCRIBE customers"),
        ("show columns customers", "SHOW COLUMNS FROM customers"),
        (
            "information_schema columns projection",
            "SELECT column_name, data_type, character_maximum_length, is_nullable, column_default \
             FROM information_schema.columns \
             WHERE table_name = 'customers' \
               AND table_schema = 'public' \
             ORDER BY ordinal_position",
        ),
    ];

    for (step, sql) in parity_cases {
        let postgres = protocol_json_response("postgres", &postgres_endpoint, Some("public"), sql);
        let flight_sql =
            protocol_json_response("flight-sql", &flight_endpoint, Some("public"), sql);
        assert_supported_protocol_equivalence(step, &postgres, &flight_sql);
    }

    cleanup_catalog_artifacts(&catalog_path);
}

// ---------------------------------------------------------------------------
// Command-tag / message consistency assertions for DML and DDL
// ---------------------------------------------------------------------------

/// The wire protocol command message for DDL operations that produce no output rows.
const WIRE_DDL_COMPLETED_MESSAGE: &str = "Command completed. 0 row(s) affected.";
/// The wire protocol command message for a single-row INSERT.
const WIRE_INSERT_1_MESSAGE: &str = "Command completed. 1 row(s) affected.";
/// The wire protocol command message for a two-row INSERT.
const WIRE_INSERT_2_MESSAGE: &str = "Command completed. 2 row(s) affected.";
/// The wire protocol query message for SELECT / SHOW / DESCRIBE statements.
const WIRE_QUERY_COMPLETED_MESSAGE: &str = "Query executed successfully.";

#[tokio::test(flavor = "multi_thread")]
async fn cli_wire_protocols_emit_consistent_command_messages_for_dml_ddl() {
    let catalog_path = temp_catalog_path();
    let (_postgres_server, postgres_endpoint) = start_postgres_server(&catalog_path).await;
    let (_flight_server, flight_endpoint) = start_flight_sql_server(&catalog_path).await;

    // Helper: assert a DDL/DML response has the expected message through both protocols.
    let check = |step: &str, pg: &QueryResponse, fl: &QueryResponse, expected: &str| {
        assert_eq!(
            pg.message, expected,
            "{step}: postgres message mismatch (got '{}')",
            pg.message
        );
        assert_eq!(
            fl.message, expected,
            "{step}: flight-sql message mismatch (got '{}')",
            fl.message
        );
        assert_eq!(
            pg.message, fl.message,
            "{step}: message diverged between protocols"
        );
    };

    // ---- CREATE DATABASE ----
    let pg_create_db = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        None,
        "CREATE DATABASE tag_test_db",
    );
    let fl_create_db = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        None,
        "CREATE DATABASE tag_test_db",
    );
    check(
        "CREATE DATABASE",
        &pg_create_db,
        &fl_create_db,
        WIRE_DDL_COMPLETED_MESSAGE,
    );

    // ---- CREATE SCHEMA ----
    let pg_create_schema = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        None,
        "CREATE SCHEMA tag_test_schema",
    );
    let fl_create_schema = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        None,
        "CREATE SCHEMA tag_test_schema",
    );
    check(
        "CREATE SCHEMA",
        &pg_create_schema,
        &fl_create_schema,
        WIRE_DDL_COMPLETED_MESSAGE,
    );

    // ---- CREATE TABLE ----
    let pg_create_table = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        Some("public"),
        "CREATE TABLE tag_tbl (id BIGINT NOT NULL, lbl TEXT)",
    );
    let fl_create_table = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        Some("public"),
        "CREATE TABLE tag_tbl (id BIGINT NOT NULL, lbl TEXT)",
    );
    check(
        "CREATE TABLE",
        &pg_create_table,
        &fl_create_table,
        WIRE_DDL_COMPLETED_MESSAGE,
    );

    // ---- CREATE VIEW ----
    let pg_create_view = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        Some("public"),
        "CREATE VIEW tag_view AS SELECT id, lbl FROM tag_tbl",
    );
    let fl_create_view = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        Some("public"),
        "CREATE VIEW tag_view AS SELECT id, lbl FROM tag_tbl",
    );
    check(
        "CREATE VIEW",
        &pg_create_view,
        &fl_create_view,
        WIRE_DDL_COMPLETED_MESSAGE,
    );

    // ---- INSERT single row ----
    let pg_insert1 = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        Some("public"),
        "INSERT INTO tag_tbl VALUES (1, 'alpha')",
    );
    let fl_insert1 = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        Some("public"),
        "INSERT INTO tag_tbl VALUES (1, 'alpha')",
    );
    check(
        "INSERT 1 row",
        &pg_insert1,
        &fl_insert1,
        WIRE_INSERT_1_MESSAGE,
    );

    // ---- INSERT two rows ----
    let pg_insert2 = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        Some("public"),
        "INSERT INTO tag_tbl VALUES (2, 'beta'), (3, 'gamma')",
    );
    let fl_insert2 = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        Some("public"),
        "INSERT INTO tag_tbl VALUES (2, 'beta'), (3, 'gamma')",
    );
    check(
        "INSERT 2 rows",
        &pg_insert2,
        &fl_insert2,
        WIRE_INSERT_2_MESSAGE,
    );

    // ---- SELECT returns the query-completed message (not 0 rows affected) ----
    let pg_select = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        Some("public"),
        "SELECT id, lbl FROM tag_tbl ORDER BY id",
    );
    let fl_select = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        Some("public"),
        "SELECT id, lbl FROM tag_tbl ORDER BY id",
    );
    check(
        "SELECT rows",
        &pg_select,
        &fl_select,
        WIRE_QUERY_COMPLETED_MESSAGE,
    );
    // Verify SELECT has no empty-row count message.
    assert!(
        !pg_select.message.contains("affected"),
        "SELECT message should not contain 'affected'; got '{}'",
        pg_select.message
    );

    // ---- DESCRIBE returns the query-completed message, not an affected-row message ----
    let pg_describe = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        Some("public"),
        "DESCRIBE tag_tbl",
    );
    let fl_describe = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        Some("public"),
        "DESCRIBE tag_tbl",
    );
    check(
        "DESCRIBE rows",
        &pg_describe,
        &fl_describe,
        WIRE_QUERY_COMPLETED_MESSAGE,
    );
    assert!(
        !pg_describe.message.contains("affected"),
        "DESCRIBE message should not contain 'affected'; got '{}'",
        pg_describe.message
    );
    assert_eq!(
        pg_describe.rows.len(),
        2,
        "DESCRIBE should return one row per table column"
    );

    // ---- ALTER USER PASSWORD ----
    let pg_alter = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        Some("public"),
        "ALTER USER analytics_reader PASSWORD 'tag-rotated'",
    );
    let fl_alter = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        Some("public"),
        "ALTER USER analytics_reader PASSWORD 'tag-rotated'",
    );
    check(
        "ALTER USER PASSWORD",
        &pg_alter,
        &fl_alter,
        WIRE_DDL_COMPLETED_MESSAGE,
    );

    cleanup_catalog_artifacts(&catalog_path);
}

// ---------------------------------------------------------------------------
// Session parameter reflection assertions from startup handshake
// ---------------------------------------------------------------------------

#[tokio::test(flavor = "multi_thread")]
async fn cli_wire_protocols_reflect_startup_session_parameters() {
    let catalog_path = temp_catalog_path();
    let (_postgres_server, postgres_endpoint) = start_postgres_server(&catalog_path).await;
    let (_flight_server, flight_endpoint) = start_flight_sql_server(&catalog_path).await;

    // Create a non-default schema and database so we can route to them.
    let _ = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        None,
        "CREATE DATABASE session_db",
    );
    let _ = protocol_json_response(
        "postgres",
        &postgres_endpoint,
        None,
        "CREATE SCHEMA session_schema",
    );
    let _ = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        None,
        "CREATE DATABASE session_db",
    );
    let _ = protocol_json_response(
        "flight-sql",
        &flight_endpoint,
        None,
        "CREATE SCHEMA session_schema",
    );

    // ---- Default parameters (postgres/postgres/public) ----
    let pg_default = protocol_json_response_with_auth_context(
        "postgres",
        &postgres_endpoint,
        None,
        None,
        "postgres",
        Some("postgres"),
        Some("postgres"),
        "SELECT 1 AS x",
    );
    let fl_default = protocol_json_response_with_auth_context(
        "flight-sql",
        &flight_endpoint,
        None,
        None,
        "postgres",
        Some("postgres"),
        Some("postgres"),
        "SELECT 1 AS x",
    );
    assert_eq!(
        pg_default.session.user, "postgres",
        "postgres default: user mismatch"
    );
    assert_eq!(
        pg_default.session.database, "postgres",
        "postgres default: database mismatch"
    );
    assert_eq!(
        pg_default.session.schema, "public",
        "postgres default: schema mismatch"
    );
    assert_eq!(
        fl_default.session.user, "postgres",
        "flight-sql default: user mismatch"
    );
    assert_eq!(
        fl_default.session.database, "postgres",
        "flight-sql default: database mismatch"
    );
    assert_eq!(
        fl_default.session.schema, "public",
        "flight-sql default: schema mismatch"
    );

    // ---- Protocol-specific auth_method values ----
    assert_eq!(
        pg_default.session.auth_method, "postgres-wire-startup",
        "postgres auth_method should be 'postgres-wire-startup'"
    );
    assert_eq!(
        fl_default.session.auth_method, "flight-sql-header",
        "flight-sql auth_method should be 'flight-sql-header'"
    );

    // ---- Non-default schema ----
    let pg_schema = protocol_json_response_with_auth_context(
        "postgres",
        &postgres_endpoint,
        None,
        Some("session_schema"),
        "postgres",
        Some("postgres"),
        Some("postgres"),
        "SELECT 1 AS x",
    );
    let fl_schema = protocol_json_response_with_auth_context(
        "flight-sql",
        &flight_endpoint,
        None,
        Some("session_schema"),
        "postgres",
        Some("postgres"),
        Some("postgres"),
        "SELECT 1 AS x",
    );
    assert_eq!(
        pg_schema.session.schema, "session_schema",
        "postgres: session.schema should reflect schema startup param"
    );
    assert_eq!(
        fl_schema.session.schema, "session_schema",
        "flight-sql: session.schema should reflect schema startup param"
    );

    // ---- Non-default database ----
    let pg_database = protocol_json_response_with_auth_context(
        "postgres",
        &postgres_endpoint,
        Some("session_db"),
        None,
        "postgres",
        Some("postgres"),
        Some("postgres"),
        "SELECT 1 AS x",
    );
    let fl_database = protocol_json_response_with_auth_context(
        "flight-sql",
        &flight_endpoint,
        Some("session_db"),
        None,
        "postgres",
        Some("postgres"),
        Some("postgres"),
        "SELECT 1 AS x",
    );
    assert_eq!(
        pg_database.session.database, "session_db",
        "postgres: session.database should reflect database startup param"
    );
    assert_eq!(
        fl_database.session.database, "session_db",
        "flight-sql: session.database should reflect database startup param"
    );

    // ---- Non-default user and role (analytics_reader) ----
    let pg_reader = protocol_json_response_with_auth_context(
        "postgres",
        &postgres_endpoint,
        None,
        None,
        "analytics_reader",
        Some("analytics_reader"),
        Some("analytics_reader"),
        "SELECT 1 AS x",
    );
    let fl_reader = protocol_json_response_with_auth_context(
        "flight-sql",
        &flight_endpoint,
        None,
        None,
        "analytics_reader",
        Some("analytics_reader"),
        Some("analytics_reader"),
        "SELECT 1 AS x",
    );
    assert_eq!(
        pg_reader.session.user, "analytics_reader",
        "postgres reader: session.user mismatch"
    );
    assert_eq!(
        pg_reader.session.role, "analytics_reader",
        "postgres reader: session.role mismatch"
    );
    assert_eq!(
        fl_reader.session.user, "analytics_reader",
        "flight-sql reader: session.user mismatch"
    );
    assert_eq!(
        fl_reader.session.role, "analytics_reader",
        "flight-sql reader: session.role mismatch"
    );

    // ---- Cross-protocol session field equivalence ----
    assert_eq!(
        pg_default.session.user, fl_default.session.user,
        "default session: user diverged across protocols"
    );
    assert_eq!(
        pg_default.session.database, fl_default.session.database,
        "default session: database diverged across protocols"
    );
    assert_eq!(
        pg_default.session.schema, fl_default.session.schema,
        "default session: schema diverged across protocols"
    );
    assert_eq!(
        pg_schema.session.schema, fl_schema.session.schema,
        "non-default schema: schema diverged across protocols"
    );
    assert_eq!(
        pg_database.session.database, fl_database.session.database,
        "non-default database: database diverged across protocols"
    );
    assert_eq!(
        pg_reader.session.user, fl_reader.session.user,
        "reader session: user diverged across protocols"
    );
    assert_eq!(
        pg_reader.session.role, fl_reader.session.role,
        "reader session: role diverged across protocols"
    );

    cleanup_catalog_artifacts(&catalog_path);
}

// ---------------------------------------------------------------------------
// Parquet external table tests
// ---------------------------------------------------------------------------

/// Write a minimal two-column Parquet file at the given path for use in tests.
/// Returns the number of rows written.
fn write_test_parquet_file(path: &str) -> usize {
    use datafusion::arrow::array::{Int64Array, StringArray};
    use datafusion::arrow::datatypes::{DataType, Field, Schema};
    use datafusion::arrow::record_batch::RecordBatch;
    use parquet::arrow::arrow_writer::ArrowWriter;
    use std::fs::File;
    use std::sync::Arc;

    let schema = Arc::new(Schema::new(vec![
        Field::new("event_id", DataType::Int64, false),
        Field::new("event_type", DataType::Utf8, false),
    ]));

    let batch = RecordBatch::try_new(
        schema.clone(),
        vec![
            Arc::new(Int64Array::from(vec![1i64, 2, 3])),
            Arc::new(StringArray::from(vec!["click", "view", "purchase"])),
        ],
    )
    .expect("test batch should build");

    let file = File::create(path).expect("parquet file should be creatable");
    let mut writer =
        ArrowWriter::try_new(file, schema, None).expect("parquet writer should initialize");
    writer.write(&batch).expect("parquet write should succeed");
    writer.close().expect("parquet writer should close");

    3
}

#[tokio::test(flavor = "multi_thread")]
async fn cli_registers_external_parquet_table_and_queries_it() {
    let catalog_path = temp_catalog_path();
    let parquet_path = {
        let mut path = std::path::PathBuf::from(&catalog_path);
        let stem = path
            .file_stem()
            .and_then(|s| s.to_str())
            .expect("catalog stem should exist")
            .to_string();
        path.set_file_name(format!("{stem}-events.parquet"));
        path.to_string_lossy().into_owned()
    };

    let row_count = write_test_parquet_file(&parquet_path);
    assert_eq!(row_count, 3);

    // Register the external Parquet table via the CLI.
    Command::cargo_bin("analyticsdb")
        .expect("binary should build")
        .args([
            "query",
            "--catalog-path",
            &catalog_path,
            "--sql",
            &format!("CREATE EXTERNAL TABLE events STORED AS PARQUET LOCATION '{parquet_path}'"),
        ])
        .assert()
        .success();

    // Verify the table is listed in SHOW TABLES.
    let tables_stdout = String::from_utf8(
        Command::cargo_bin("analyticsdb")
            .expect("binary should build")
            .args([
                "query",
                "--catalog-path",
                &catalog_path,
                "--sql",
                "SHOW TABLES",
            ])
            .assert()
            .success()
            .get_output()
            .stdout
            .clone(),
    )
    .expect("stdout should be valid utf-8");
    assert!(
        tables_stdout.contains("events"),
        "SHOW TABLES should list the external table; got: {tables_stdout}"
    );

    // Query the external table in a later CLI invocation.
    let query_stdout = String::from_utf8(
        Command::cargo_bin("analyticsdb")
            .expect("binary should build")
            .args([
                "query",
                "--catalog-path",
                &catalog_path,
                "--sql",
                "SELECT event_id, event_type FROM events ORDER BY event_id",
            ])
            .assert()
            .success()
            .get_output()
            .stdout
            .clone(),
    )
    .expect("stdout should be valid utf-8");

    assert!(
        query_stdout.contains("event_id") && query_stdout.contains("event_type"),
        "query output should contain column headers; got: {query_stdout}"
    );
    assert!(
        query_stdout.contains("click"),
        "query output should contain 'click' row; got: {query_stdout}"
    );
    assert!(
        query_stdout.contains("purchase"),
        "query output should contain 'purchase' row; got: {query_stdout}"
    );

    // Verify the table can be queried with a filter.
    let filter_stdout = String::from_utf8(
        Command::cargo_bin("analyticsdb")
            .expect("binary should build")
            .args([
                "query",
                "--catalog-path",
                &catalog_path,
                "--sql",
                "SELECT event_id FROM events WHERE event_type = 'view'",
            ])
            .assert()
            .success()
            .get_output()
            .stdout
            .clone(),
    )
    .expect("stdout should be valid utf-8");

    assert!(
        filter_stdout.contains('2'),
        "filter query should return event_id=2 for 'view' event; got: {filter_stdout}"
    );

    cleanup_catalog_artifacts(&catalog_path);
    let _ = std::fs::remove_file(&parquet_path);
}

#[tokio::test(flavor = "multi_thread")]
async fn cli_ddl_comprehensive_lifecycle() {
    let catalog_path = temp_catalog_path();
    let (_server, endpoint) = start_postgres_server(&catalog_path).await;

    let ddl_sequence = [
        // 1. Database Lifecycle
        "CREATE DATABASE corp_data",
        "SHOW DATABASES",
        // 2. Schema Lifecycle
        "CREATE SCHEMA corp_data.finance",
        "SHOW SCHEMAS FROM corp_data",
        // 3. Table Lifecycle (Managed with constraints/defaults)
        "CREATE TABLE corp_data.finance.ledger (
            entry_id INT PRIMARY KEY,
            account_name TEXT NOT NULL,
            amount DOUBLE PRECISION DEFAULT 0.0,
            recorded_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )",
        "SHOW TABLES FROM corp_data.finance",
        "DESCRIBE corp_data.finance.ledger",
        // 4. Data sanity check
        "INSERT INTO corp_data.finance.ledger (entry_id, account_name) VALUES (1, 'Cash')",
        "SELECT entry_id, account_name, amount FROM corp_data.finance.ledger",
        // 5. View Lifecycle
        "CREATE VIEW corp_data.finance.summary AS SELECT account_name, SUM(amount) FROM corp_data.finance.ledger GROUP BY account_name",
        "SHOW VIEWS FROM corp_data.finance",
        // 6. Cleanup Lifecycle (CASCADE and IF EXISTS)
        "DROP VIEW corp_data.finance.summary",
        "DROP TABLE IF EXISTS corp_data.finance.ledger",
        "DROP SCHEMA corp_data.finance CASCADE",
        "DROP DATABASE corp_data",
    ];

    for sql in ddl_sequence {
        let response = protocol_json_response("postgres", &endpoint, None, sql);
        assert!(
            !response.message.is_empty(),
            "DDL command '{}' should return a success message",
            sql
        );
    }

    // Final verification that DB is gone
    let final_dbs = protocol_json_response("postgres", &endpoint, None, "SHOW DATABASES");
    let has_corp = final_dbs.rows.iter().any(|row| row[0] == "corp_data");
    assert!(!has_corp, "corp_data database should have been dropped");

    cleanup_catalog_artifacts(&catalog_path);
}

#[tokio::test(flavor = "multi_thread")]
async fn cli_supports_omitted_column_with_default() {
    let catalog_path = temp_catalog_path();
    let (_server, endpoint) = start_postgres_server(&catalog_path).await;

    // 1. Create table with the user's exact SQL (variant with parentheses)
    protocol_json_response(
        "postgres",
        &endpoint,
        None,
        "CREATE TABLE customers_v2 (
    id INT PRIMARY KEY,
    first_name VARCHAR(50) NOT NULL,
    last_name VARCHAR(50) NOT NULL,
    email VARCHAR(100) UNIQUE NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP()
)",
    );

    // 2. Insert row omitting created_at
    protocol_json_response(
        "postgres",
        &endpoint,
        None,
        "INSERT INTO customers_v2 (id, first_name, last_name, email) VALUES (8, 'Jane', 'Smith', 'jane.smith@example.com')",
    );

    // 3. Verify results
    let response = protocol_json_response(
        "postgres",
        &endpoint,
        None,
        "SELECT id, first_name, last_name, email, created_at FROM customers_v2",
    );

    assert_eq!(response.rows.len(), 1);
    assert_eq!(response.rows[0][0], "8");
    assert_eq!(response.rows[0][4].contains('T'), true);

    cleanup_catalog_artifacts(&catalog_path);
}

#[tokio::test(flavor = "multi_thread")]
async fn cli_supports_single_endpoint_routing_via_control_plane() {
    let catalog_path = temp_catalog_path();
    let listener = TcpListener::bind("127.0.0.1:0")
        .await
        .expect("listener should bind");
    let addr = listener.local_addr().expect("local addr should exist");

    let engine = Arc::new(
        PrototypeEngine::from_catalog_path(&catalog_path)
            .await
            .expect("engine should initialize"),
    );

    // 1. Register a specific node ID
    let expected_node_id = "test-coordinator-42";
    engine
        .control_plane()
        .register_node(ClusterNode {
            id: expected_node_id.to_string(),
            role: NodeRole::Control,
            endpoint: addr.to_string(),
            status: NodeStatus::Ready,
            last_heartbeat_at_epoch_ms: 0,
        })
        .await
        .expect("node registration should succeed");

    let task = tokio::spawn(serve_postgres_wire(listener, Arc::clone(&engine)));
    tokio::time::sleep(Duration::from_millis(50)).await;

    // 2. Query and verify the node is registered
    let response = protocol_json_response(
        "postgres",
        &format!("127.0.0.1:{}", addr.port()),
        None,
        "SHOW NODES",
    );

    // Columns: node_id, role, endpoint, status
    let node_ids: Vec<String> = response.rows.iter().map(|r| r[0].clone()).collect();
    assert!(node_ids.contains(&expected_node_id.to_string()));

    task.abort();
    cleanup_catalog_artifacts(&catalog_path);
}

#[tokio::test(flavor = "multi_thread")]
async fn cli_supports_multi_endpoint_failover() {
    let catalog_path = temp_catalog_path();

    // 1. Start one server and then kill it to simulate failure
    let (server1, addr1) = start_postgres_server(&catalog_path).await;
    drop(server1); // Kill it immediately

    // 2. Start a second server that is healthy
    let (_server2, addr2) = start_postgres_server(&catalog_path).await;

    // 3. Query with both endpoints, expecting failover to work
    let response = protocol_json_response(
        "postgres",
        &format!("{},{}", addr1, addr2),
        None,
        "SELECT 1",
    );

    assert_eq!(response.rows.len(), 1);
    assert_eq!(response.rows[0][0], "1");

    cleanup_catalog_artifacts(&catalog_path);
}
