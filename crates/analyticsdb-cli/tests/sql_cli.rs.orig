#[tokio::test(flavor = "multi_thread")]
async fn cli_uses_managed_table_indexes_for_equality_lookup() {
    let catalog_path = temp_catalog_path();

    for sql in [
        "CREATE TABLE customers (id BIGINT PRIMARY KEY, email TEXT UNIQUE, name TEXT)",
        "INSERT INTO customers VALUES (1, 'one@example.test', 'one'), (66666, 'target@example.test', 'target')",
        "CREATE INDEX customers_email_lookup_idx ON customers (email)",
    ] {
        Command::cargo_bin("analyticsdb")
            .expect("binary should build")
            .args(["query", "--catalog-path", &catalog_path, "--sql", sql])
            .assert()
            .success();
    }

    let by_primary_key = cli_json_response({
        let mut command = Command::cargo_bin("analyticsdb").expect("binary should build");
        command.args([
            "query",
            "--format",
            "json",
            "--catalog-path",
            &catalog_path,
            "--sql",
            "SELECT * FROM customers WHERE id = 66666",
        ]);
        command
    });
    assert_eq!(
        by_primary_key.rows,
        vec![vec![
            "66666".to_string(),
            "target@example.test".to_string(),
            "target".to_string(),
        ]]
    );
    assert!(by_primary_key.message.contains("using index"));

    let by_created_index = cli_json_response({
        let mut command = Command::cargo_bin("analyticsdb").expect("binary should build");
        command.args([
            "query",
            "--format",
            "json",
            "--catalog-path",
            &catalog_path,
            "--sql",
            "SELECT id, name FROM customers WHERE email = 'target@example.test'",
        ]);
        command
    });
    assert_eq!(by_created_index.columns, vec!["id", "name"]);
    assert_eq!(
        by_created_index.rows,
        vec![vec!["66666".to_string(), "target".to_string(),]]
    );

    let duplicate_output = Command::cargo_bin("analyticsdb")
        .expect("binary should build")
        .args([
            "query",
            "--catalog-path",
            &catalog_path,
            "--sql",
            "INSERT INTO customers VALUES (66666, 'dupe@example.test', 'dupe')",
        ])
        .assert()
        .failure()
        .get_output()
        .stderr
        .clone();
    let duplicate_stderr =
        String::from_utf8(duplicate_output).expect("stderr should be valid utf-8");
    assert!(duplicate_stderr.contains("duplicate key"));

    cleanup_catalog_artifacts(&catalog_path);
}

#[tokio::test(flavor = "multi_thread")]
async fn cli_supports_create_alter_and_drop_index_statements() {
    let catalog_path = temp_catalog_path();

    for sql in [
        "CREATE TABLE customers (id BIGINT NOT NULL, email TEXT, name TEXT)",
        "INSERT INTO customers VALUES (1, 'one@example.test', 'one'), (2, 'two@example.test', 'two')",
        "CREATE INDEX customers_email_idx ON customers (email)",
        "ALTER INDEX customers_email_idx RENAME TO customers_email_lookup_idx",
    ] {
        Command::cargo_bin("analyticsdb")
            .expect("binary should build")
            .args(["query", "--catalog-path", &catalog_path, "--sql", sql])
            .assert()
            .success();
    }

    let renamed_index_query = cli_json_response({
        let mut command = Command::cargo_bin("analyticsdb").expect("binary should build");
        command.args([
            "query",
            "--format",
            "json",
            "--catalog-path",
            &catalog_path,
            "--sql",
            "SELECT id FROM customers WHERE email = 'two@example.test'",
        ]);
        command
    });
    assert_eq!(renamed_index_query.rows, vec![vec!["2".to_string()]]);
    assert!(renamed_index_query
        .message
        .contains("customers_email_lookup_idx"));

    Command::cargo_bin("analyticsdb")
        .expect("binary should build")
        .args([
            "query",
            "--catalog-path",
            &catalog_path,
            "--sql",
            "DROP INDEX customers_email_lookup_idx",
        ])
        .assert()
        .success();

    let after_drop = cli_json_response({
        let mut command = Command::cargo_bin("analyticsdb").expect("binary should build");
        command.args([
            "query",
            "--format",
            "json",
            "--catalog-path",
            &catalog_path,
            "--sql",
            "SELECT id FROM customers WHERE email = 'two@example.test'",
        ]);
        command
    });
    assert_eq!(after_drop.rows, vec![vec!["2".to_string()]]);
    assert!(!after_drop.message.contains("using index"));

    cleanup_catalog_artifacts(&catalog_path);
}

#[tokio::test(flavor = "multi_thread")]
async fn cli_streams_insert_select_into_managed_table() {
    let catalog_path = temp_catalog_path();

    Command::cargo_bin("analyticsdb")
        .expect("binary should build")
        .args([
            "query",
            "--catalog-path",
            &catalog_path,
            "--sql",
            "CREATE TABLE customers (id BIGINT NOT NULL, first_name TEXT, last_name TEXT, email TEXT, created_at TIMESTAMP)",
        ])
        .assert()
        .success();

    let insert_output = Command::cargo_bin("analyticsdb")
        .expect("binary should build")
        .args([
            "query",
            "--catalog-path",
            &catalog_path,
            "--sql",
            "
            INSERT INTO customers (id, first_name, last_name, email, created_at)
            SELECT
                n,
                left(md5(random()::text), 8),
                left(md5(random()::text), 10),
                'user' || n || '@' || left(md5(random()::text), 6) || '.com',
                NOW() - (random() * INTERVAL '5 years')
            FROM generate_series(1, 1000) AS s(n)
            ",
        ])
        .assert()
        .success()
        .get_output()
        .stdout
        .clone();

    let insert_stdout = String::from_utf8(insert_output).expect("stdout should be valid utf-8");

    assert!(
        insert_stdout.contains("Message: Inserted 1000 row(s) into 'postgres.public.customers'.")
    );

    let query_output = Command::cargo_bin("analyticsdb")
        .expect("binary should build")
        .args([
            "query",
            "--catalog-path",
            &catalog_path,
            "--sql",
            "SELECT COUNT(*) AS row_count, MIN(id) AS min_id, MAX(id) AS max_id FROM customers",
        ])
        .assert()
        .success()
        .get_output()
        .stdout
        .clone();

    let query_stdout = String::from_utf8(query_output).expect("stdout should be valid utf-8");

    assert!(query_stdout.contains("| row_count | min_id | max_id |"));
    assert!(query_stdout.contains("| 1000      | 1      | 1000   |"));

    cleanup_catalog_artifacts(&catalog_path);
}

