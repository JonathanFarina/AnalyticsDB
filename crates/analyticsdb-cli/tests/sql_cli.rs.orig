#[tokio::test(flavor = "multi_thread")]
async fn cli_postgres_protocol_accepts_common_set_and_reset_statements() {
    let catalog_path = temp_catalog_path();
    let (_server, endpoint) = start_postgres_server(&catalog_path).await;

    for sql in [
        "SET extra_float_digits = 3",
        "SET application_name = 'cli-test-client'",
        "SET SESSION statement_timeout TO '5s'",
        "SET LOCAL extra_float_digits = 3",
        "SET TIME ZONE 'UTC'",
        "SET NAMES 'UTF8'",
        "RESET application_name",
        "RESET ALL",
    ] {
        let response = protocol_json_response("postgres", &endpoint, None, sql);
        assert_eq!(
            response.message, "Command completed. 0 row(s) affected.",
            "unexpected message for sql={sql}: {:?}",
            response
        );
        assert!(
            response.columns.is_empty(),
            "sql={sql} should not return columns"
        );
        assert!(response.rows.is_empty(), "sql={sql} should not return rows");
    }

    cleanup_catalog_artifacts(&catalog_path);
}

#[tokio::test(flavor = "multi_thread")]
async fn cli_postgres_protocol_supports_show_parameter_and_show_all() {
    let catalog_path = temp_catalog_path();
    let (_server, endpoint) = start_postgres_server(&catalog_path).await;

    let show_search_path = protocol_json_response("postgres", &endpoint, None, "SHOW search_path");
    assert_eq!(show_search_path.columns, vec!["search_path"]);
    assert_eq!(show_search_path.rows, vec![vec!["public".to_string()]]);

    let show_transaction_isolation =
        protocol_json_response("postgres", &endpoint, None, "SHOW transaction_isolation");
    assert_eq!(
        show_transaction_isolation.columns,
        vec!["transaction_isolation"]
    );
    assert_eq!(
        show_transaction_isolation.rows,
        vec![vec!["read committed".to_string()]]
    );

    let show_all = protocol_json_response("postgres", &endpoint, None, "SHOW ALL");
    assert_eq!(show_all.columns, vec!["name", "setting"]);
    assert!(
        show_all.rows.iter().any(|row| {
            row.first() == Some(&"search_path".to_string())
                && row.get(1) == Some(&"public".to_string())
        }),
        "SHOW ALL rows={:?}",
        show_all.rows
    );
    assert!(
        show_all.rows.iter().any(|row| {
            row.first() == Some(&"client_encoding".to_string())
                && row.get(1) == Some(&"UTF8".to_string())
        }),
        "SHOW ALL rows={:?}",
        show_all.rows
    );
    assert!(
        show_all.rows.iter().any(|row| {
            row.first() == Some(&"transaction_isolation".to_string())
                && row.get(1) == Some(&"read committed".to_string())
        }),
        "SHOW ALL rows={:?}",
        show_all.rows
    );

    cleanup_catalog_artifacts(&catalog_path);
}

#[tokio::test(flavor = "multi_thread")]
async fn cli_postgres_protocol_supports_transaction_isolation_session_characteristics() {
    let catalog_path = temp_catalog_path();
    let (_server, endpoint) = start_postgres_server(&catalog_path).await;

    let set_characteristics = protocol_json_response(
        "postgres",
        &endpoint,
        None,
        "SET SESSION CHARACTERISTICS AS TRANSACTION ISOLATION LEVEL SERIALIZABLE",
    );
    assert_eq!(
        set_characteristics.message,
        "Command completed. 0 row(s) affected."
    );

    let show_alias = protocol_json_response(
        "postgres",
        &endpoint,
        None,
        "SHOW TRANSACTION ISOLATION LEVEL",
    );
    assert_eq!(show_alias.columns, vec!["transaction_isolation"]);
    assert_eq!(show_alias.rows, vec![vec!["read committed".to_string()]]);

    let current_setting = protocol_json_response(
        "postgres",
        &endpoint,
        None,
        "SELECT current_setting('transaction_isolation') AS tx_iso",
    );
    assert_eq!(current_setting.columns, vec!["tx_iso"]);
    assert_eq!(
        current_setting.rows,
        vec![vec!["read committed".to_string()]]
    );

    let reset = protocol_json_response("postgres", &endpoint, None, "RESET transaction_isolation");
    assert_eq!(reset.message, "Command completed. 0 row(s) affected.");

    cleanup_catalog_artifacts(&catalog_path);
}

#[tokio::test(flavor = "multi_thread")]
async fn cli_postgres_protocol_supports_common_introspection_selects() {
    let catalog_path = temp_catalog_path();
    let (_server, endpoint) = start_postgres_server(&catalog_path).await;

    let version = protocol_json_response("postgres", &endpoint, None, "SELECT version()");
    assert_eq!(version.columns, vec!["version()"]);
    assert!(
        version.rows.iter().any(|row| row
            .first()
            .is_some_and(|value| value.contains("analyticsdb-prototype"))),
        "version rows={:?}",
        version.rows
    );

    let current_database =
        protocol_json_response("postgres", &endpoint, None, "SELECT current_database()");
    assert_eq!(current_database.columns, vec!["current_database()"]);
    assert_eq!(current_database.rows, vec![vec!["postgres".to_string()]]);

    let current_schema =
        protocol_json_response("postgres", &endpoint, None, "SELECT current_schema()");
    assert_eq!(current_schema.columns, vec!["current_schema()"]);
    assert_eq!(current_schema.rows, vec![vec!["public".to_string()]]);

    let current_user = protocol_json_response("postgres", &endpoint, None, "SELECT current_user");
    assert_eq!(current_user.columns, vec!["current_user()"]);
    assert_eq!(current_user.rows, vec![vec!["postgres".to_string()]]);

    let session_user = protocol_json_response("postgres", &endpoint, None, "SELECT session_user");
    assert_eq!(session_user.columns, vec!["session_user()"]);
    assert_eq!(session_user.rows, vec![vec!["postgres".to_string()]]);

    let current_setting = protocol_json_response(
        "postgres",
        &endpoint,
        None,
        "SELECT current_setting('search_path') AS active_search_path",
    );
    assert_eq!(current_setting.columns, vec!["active_search_path"]);
    assert_eq!(current_setting.rows, vec![vec!["public".to_string()]]);

    cleanup_catalog_artifacts(&catalog_path);
}

#[tokio::test(flavor = "multi_thread")]
async fn cli_executes_parameterized_sql_via_postgres_protocol_server() {
    let catalog_path = temp_catalog_path();
    let (_server, endpoint) = start_postgres_server(&catalog_path).await;

    Command::cargo_bin("analyticsdb")
        .expect("binary should build")
        .args([
            "query",
            "--protocol",
            "postgres",
            "--endpoint",
            &endpoint,
            "--password",
            "postgres",
            "--sql",
            "CREATE TABLE fact_metrics (metric BIGINT NOT NULL, status TEXT)",
        ])
        .assert()
        .success();

    let insert_output = Command::cargo_bin("analyticsdb")
        .expect("binary should build")
        .args([
            "query",
            "--protocol",
            "postgres",
            "--endpoint",
            &endpoint,
            "--password",
            "postgres",
            "--sql",
            "INSERT INTO fact_metrics VALUES ($1, $2)",
            "--param",
            "11",
            "--param",
            "\"ok\"",
        ])
        .assert()
        .success()
        .get_output()
        .stdout
        .clone();

    let insert_stdout = String::from_utf8(insert_output).expect("stdout should be valid utf-8");
    assert!(insert_stdout.contains("Message: Command completed. 1 row(s) affected."));

    let query_output = Command::cargo_bin("analyticsdb")
        .expect("binary should build")
        .args([
            "query",
            "--protocol",
            "postgres",
            "--endpoint",
            &endpoint,
            "--password",
            "postgres",
            "--sql",
            "SELECT metric, status FROM fact_metrics WHERE metric = $1",
            "--param",
            "11",
        ])
        .assert()
        .success()
        .get_output()
        .stdout
        .clone();

    let query_stdout = String::from_utf8(query_output).expect("stdout should be valid utf-8");

    assert!(query_stdout.contains("Message: Query executed successfully."));
    assert!(query_stdout.contains("| metric | status |"));
    assert!(query_stdout.contains("| 11     | ok     |"));

    let marker_literal_output = Command::cargo_bin("analyticsdb")
        .expect("binary should build")
        .args([
            "query",
            "--protocol",
            "postgres",
            "--endpoint",
            &endpoint,
            "--password",
            "postgres",
            "--sql",
            "SELECT '$1' AS literal_value, $1 AS bound_value",
            "--param",
            "\"value\"",
        ])
        .assert()
        .success()
        .get_output()
        .stdout
        .clone();
    let marker_literal_stdout =
        String::from_utf8(marker_literal_output).expect("stdout should be valid utf-8");
    assert!(marker_literal_stdout.contains("literal_value"));
    assert!(marker_literal_stdout.contains("bound_value"));
    assert!(marker_literal_stdout.contains("$1"));
    assert!(marker_literal_stdout.contains("value"));

    cleanup_catalog_artifacts(&catalog_path);
}

